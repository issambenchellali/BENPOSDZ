@page "/invoices"
@using BENPOSDZ.Services
@using Dapper
@inject DatabaseService dbService
@inject IJSRuntime JS
@inject PrintTemplateService printService
@inject PrintService sysPrintService


<div class="filters-bar">
    <label>من تاريخ:</label>
    <input type="date" @bind="filterDateFrom" @bind:after="LoadInvoices" class="filter-input" />
    <label>إلى تاريخ:</label>
    <input type="date" @bind="filterDateTo" @bind:after="LoadInvoices" class="filter-input" />
    <input type="text" @bind="filterCustomer" @bind:event="oninput" @bind:after="LoadInvoices" placeholder="🔍 بحث بالزبون..." class="filter-input" />
    <label class="debt-filter"><input type="checkbox" @bind="filterDebtOnly" @bind:after="LoadInvoices" /> الديون فقط</label>
</div>

<div class="inv-tabs">
    @foreach (var sec in sections)
    {
        <div class="inv-tab @sec.CssClass @(activeTabKey == sec.Key ? "active" : "")" @onclick="() => activeTabKey = sec.Key">
            <span>@sec.Emoji @sec.Title</span>
            <span class="inv-tab-count">@sec.Items.Count</span>
        </div>
    }
</div>

@{
    var activeSec = sections.FirstOrDefault(s => s.Key == activeTabKey);
}
@if (activeSec != null)
{
    <div class="inv-section">
        <div class="inv-section-header @activeSec.CssClass">
            <span>@activeSec.Emoji @activeSec.Title</span>
            <span class="inv-count">@activeSec.Items.Count فاتورة</span>
        </div>
        @if (activeSec.Items.Any())
        {
            <table class="invoices-table">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الزبون</th>
                        <th>المجموع</th>
                        <th>المدفوع</th>
                        <th>الدين</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in activeSec.Items)
                    {
                        <tr>
                            <td>@inv.Order_Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@inv.Person_Name</td>
                            <td>@inv.Price د.ج</td>
                            <td>@inv.Paid د.ج</td>
                            <td class="@(inv.Order_Type <= 2 && inv.Unpaid > 0 ? "debt-color" : "")">@((inv.Order_Type <= 2 ? inv.Unpaid : 0).ToString("0.00")) د.ج</td>
                            <td>
                                <button class="btn-print" @onclick='() => PrintInvoice(inv.Id, "receipt")'>🧾 وصل</button>
                                <button class="btn-print" @onclick='() => PrintInvoice(inv.Id, "invoice")'>📄 فاتورة</button>
                                <button class="btn-print" @onclick='() => PrintInvoice(inv.Id, "delivery")'>🚚 BL</button>
                                <button class="btn-view" @onclick="() => ViewDetails(inv.Id)">👁️</button>
                                <button class="btn-return" @onclick="() => InitiateReturn(inv.Id)">↩️</button>
                                @if (authService.IsAdmin)
                                {
                                    <button class="btn-delete" @onclick="() => DeleteInvoice(inv.Id)">🗑️</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="no-data">لا توجد فواتير في هذا القسم</p>
        }
    </div>
}

@if (showDetailsModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h3>تفاصيل الفاتورة</h3>
            <table class="details-table">
                <thead><tr><th>السلعة</th><th>الكمية</th><th>السعر</th><th>المجموع</th></tr></thead>
                <tbody>
                    @foreach(var det in invoiceDetails)
                    {
                        <tr><td>@det.Pro_Name</td><td>@det.Pro_Qty</td><td>@det.Pro_Price</td><td>@((det.Pro_Qty * det.Pro_Price).ToString("0.00"))</td></tr>
                    }
                </tbody>
            </table>
            <button class="btn-cancel" @onclick="() => showDetailsModal = false" style="width:100%">إغلاق</button>
        </div>
    </div>
}

@if (showReturnModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h3>استرجاع سلع من الفاتورة</h3>
            <table class="details-table">
                <thead><tr><th>السلعة</th><th>الكمية الأصلية</th><th>كمية الإرجاع</th></tr></thead>
                <tbody>
                    @foreach(var det in invoiceDetails)
                    {
                        <tr>
                            <td>@det.Pro_Name</td>
                            <td>@det.Pro_Qty</td>
                            <td><input type="number" min="0" max="@det.Pro_Qty" @bind="det.ReturnQty" style="width: 70px;" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="modal-actions">
                <button class="btn-save" @onclick="ConfirmReturn">تأكيد الإرجاع</button>
                <button class="btn-cancel" @onclick="() => showReturnModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

