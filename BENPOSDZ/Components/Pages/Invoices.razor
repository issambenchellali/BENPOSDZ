    .invoices-table td { padding: 10px; border-bottom: 1px solid #eee; }
    .debt-color { color: #dc3545; font-weight: bold; }
    .btn-print { background: #17a2b8; color: white; border: none; padding: 5px 8px; border-radius: 4px; cursor: pointer; }
