    .sec-sale { background: linear-gradient(135deg, #28a745, #218838); }
    .sec-purchase { background: linear-gradient(135deg, #007bff, #0062cc); }
    .sec-return { background: linear-gradient(135deg, #ffc107, #e0a800); color: #333; }
