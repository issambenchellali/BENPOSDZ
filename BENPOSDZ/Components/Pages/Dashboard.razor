    .fin-mini-table td { padding: 9px 0; border-bottom: 1px solid #f8f8f8; font-size: 14px; }

    .fin-exp-table-wrap { overflow-x: auto; }
    .fin-exp-table { width: 100%; border-collapse: collapse; }
    .fin-exp-table th { background: #f8f9fa; padding: 10px; text-align: right; border-bottom: 2px solid #dee2e6; color: #333; }
    .fin-exp-table td { padding: 10px; border-bottom: 1px solid #eee; }
    .exp-amount { font-weight: bold; color: #dc3545; }
    .fin-del { background: none; border: none; cursor: pointer; color: #dc3545; font-size: 16px; }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 1000;}
    .modal-box { background: white; padding: 25px; border-radius: 12px; display: flex; flex-direction: column; gap: 10px; text-align: center; }
    .form-group { text-align: right; margin-bottom: 10px; }
    .form-group label { display: block; font-weight: bold; margin-bottom: 5px; }
    .form-group input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; }
    .modal-actions { display: flex; justify-content: space-between; margin-top: 20px; }
    .btn-save { background: #007bff; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 45%; }
    .btn-cancel { background: #6c757d; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 45%; }
</style>

@code {
    private bool settingsShowCaisse = false;
    private string loadError = "";
    private decimal caisseAmount = 0;
    private decimal cofferAmount = 0;
    private decimal todayExpenses = 0;
    private decimal stockBuyValue = 0, stockWholesaleValue = 0, stockRetailMinValue = 0, stockRetailMaxValue = 0;

    private List<LowStockModel> lowStockProducts = new();
    private List<ExpiredProductModel> expiredProducts = new();
    private List<RecentInvoiceModel> recentInvoices = new();
    private List<ExpenseModel> expensesList = new();

    private PeriodStats? todayStats;
    private PeriodStats? monthStats;
    private PeriodStats? totalStats;
    private int selectedPeriod = 0;
    private PeriodStats? CurrentPeriod => selectedPeriod switch { 1 => monthStats, 2 => totalStats, _ => todayStats };

    private bool showTransferModal = false;
    private decimal transferAmount = 0;
    private bool showExpenseModal = false;
    private string newExpenseName = "";
    private decimal newExpensePrice = 0;
    private string newExpenseNotes = "";

    protected override async Task OnInitializedAsync()
    {
        if (!authService.IsLicensed) { Nav.NavigateTo("/pos"); return; }

        try
        {
            if (authService.IsAdmin)
            {
                using var localConn = dbService.CreateLocalConnection();
                var settingVal = await localConn.QueryFirstOrDefaultAsync<string>("SELECT `Value` FROM AppSettings WHERE `Key` = 'ShowCaisseToVendeur'");
                settingsShowCaisse = (settingVal == "true");
            }

            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private async Task LoadAllAsync()
    {
        try
        {
            loadError = "";
            using var connection = dbService.CreateConnection();

            await QueryProfiler.TimeAsync(dbService, "Dashboard.Balances", async () =>
            {
                caisseAmount = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(Amount, 0) FROM Caisse LIMIT 1");
                cofferAmount = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(Amount, 0) FROM Coffer LIMIT 1");
            });

            string today = DateTime.UtcNow.ToString("yyyy-MM-dd");
            todayExpenses = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(SUM(Expn_Price), 0) FROM Expenses WHERE substr(Expn_Date, 1, 10) = @Today AND IsDeleted = 0", new { Today = today });

            if (authService.IsAdmin)
            {
                var now = DateTime.UtcNow;
                var todayFrom = new DateTime(now.Year, now.Month, now.Day);
                var tomorrow = todayFrom.AddDays(1);
                var monthFrom = new DateTime(now.Year, now.Month, 1);
                var nextMonth = monthFrom.AddMonths(1);
                string Fmt(DateTime d) => d.ToString("yyyy-MM-dd HH:mm:ss");

                todayStats = await GetPeriodStats(Fmt(todayFrom), Fmt(tomorrow));
                monthStats = await GetPeriodStats(Fmt(monthFrom), Fmt(nextMonth));
                totalStats = await GetPeriodStats("2000-01-01 00:00:00", "2100-01-01 00:00:00");

                await QueryProfiler.TimeAsync(dbService, "Dashboard.Inventory", async () =>
                {
                    stockBuyValue = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(SUM(Pro_Qty * Pro_BuyPrice), 0) FROM Products WHERE IsDeleted = 0");
                    stockWholesaleValue = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(SUM(Pro_Qty * Pro_SalePriceG), 0) FROM Products WHERE IsDeleted = 0");
                    stockRetailMinValue = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(SUM(Pro_Qty * Pro_SalePrice_Min), 0) FROM Products WHERE IsDeleted = 0");
                    stockRetailMaxValue = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(SUM(Pro_Qty * Pro_SalePrice_Max), 0) FROM Products WHERE IsDeleted = 0");
                });
            }

            await QueryProfiler.TimeAsync(dbService, "Dashboard.RecentLists", async () =>
            {
                lowStockProducts = (await connection.QueryAsync<LowStockModel>("SELECT Pro_Name, Pro_Qty, Pro_Unit FROM Products WHERE IsDeleted = 0 AND Pro_QtyMin > 0 AND Pro_Qty <= Pro_QtyMin LIMIT 10")).ToList();

                string recentSql = @"SELECT o.Order_Date, o.Price, CASE WHEN p.Person_Name IS NULL THEN 'Au Comptoir' ELSE p.Person_Name END as Person_Name FROM Orders o LEFT JOIN Persons p ON o.Person_ID = p.Id WHERE o.IsDeleted = 0 AND o.Order_Type IN (0,1) ORDER BY o.Order_Date DESC LIMIT 5";
                recentInvoices = (await connection.QueryAsync<RecentInvoiceModel>(recentSql)).ToList();

                string expiredSql = "SELECT Pro_Name, Pro_date_exp FROM Products WHERE IsDeleted = 0 AND Pro_date_exp IS NOT NULL AND date(Pro_date_exp) < " + (dbService.DBMode == "LAN" ? "CURDATE()" : "date('now')") + " LIMIT 10";
                expiredProducts = (await connection.QueryAsync<ExpiredProductModel>(expiredSql)).ToList();
            });

            await LoadExpensesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            toastService.ShowError("خطأ في تحميل البيانات: " + ex.Message, "❌ لوحة التحكم");
        }
    }

    private async Task<PeriodStats> GetPeriodStats(string from, string to)
    {
        return await QueryProfiler.TimeAsync(dbService, $"Dashboard.PeriodStats({from}..{to})", async () =>
        {
            using var connection = dbService.CreateConnection();
            var p = new { From = from, To = to };

            decimal sales = await connection.ExecuteScalarAsync<decimal>(
                "SELECT COALESCE(SUM(Price),0) FROM Orders WHERE Order_Type IN (0,1) AND IsDeleted=0 AND Order_Date >= @From AND Order_Date < @To", p);
            decimal purchases = await connection.ExecuteScalarAsync<decimal>(
                "SELECT COALESCE(SUM(Price),0) FROM Orders WHERE Order_Type=2 AND IsDeleted=0 AND Order_Date >= @From AND Order_Date < @To", p);
            decimal returns = await connection.ExecuteScalarAsync<decimal>(
                "SELECT COALESCE(SUM(Price),0) FROM Orders WHERE Order_Type IN (3,4) AND IsDeleted=0 AND Order_Date >= @From AND Order_Date < @To", p);
            decimal profit = await connection.ExecuteScalarAsync<decimal>(@"
                SELECT COALESCE(SUM((od.Pro_Price - pr.Pro_BuyPrice) * od.Pro_Qty * (CASE WHEN o.Order_Type IN (3,4) THEN -1 ELSE 1 END)),0)
                FROM Order_Details od
                JOIN Orders o ON od.Order_ID = o.Id
                JOIN Products pr ON od.Pro_ID = pr.Id
                WHERE o.Order_Type IN (0,1,3,4) AND o.IsDeleted = 0 AND o.Order_Date >= @From AND o.Order_Date < @To", p);
            decimal expenses = await connection.ExecuteScalarAsync<decimal>(
                "SELECT COALESCE(SUM(Expn_Price),0) FROM Expenses WHERE IsDeleted=0 AND Expn_Date >= @From AND Expn_Date < @To", p);

            return new PeriodStats(sales, purchases, returns, profit, expenses);
        });
    }

