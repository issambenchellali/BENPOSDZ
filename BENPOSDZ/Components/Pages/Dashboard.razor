    private void OpenTransferModal() { transferAmount = caisseAmount; showTransferModal = true; }

    private async Task ConfirmTransfer()
    {
        if (transferAmount <= 0 || transferAmount > caisseAmount)
        {
            toastService.ShowWarning("مبلغ غير صالح", "⚠️ النقل");
            return;
        }

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
            await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount - @Amt, UpdatedAt = @Date", new { Amt = transferAmount, Date = dateNow }, transaction);
            await connection.ExecuteAsync("UPDATE Coffer SET Amount = Amount + @Amt, UpdatedAt = @Date", new { Amt = transferAmount, Date = dateNow }, transaction);

            transaction.Commit();
            showTransferModal = false;
            toastService.ShowSuccessShort("تم نقل المبلغ إلى الخزنة بنجاح", "✅ النقل");
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ: " + ex.Message, "❌ النقل");
        }
    }

    private void OpenExpenseModal()
    {
        newExpenseName = "";
        newExpensePrice = 0;
        newExpenseNotes = "";
        showExpenseModal = true;
    }

    private async Task SaveExpense()
    {
        if (!authService.IsAdmin) return;
        if (newExpensePrice <= 0 || string.IsNullOrWhiteSpace(newExpenseName))
        {
            toastService.ShowWarning("الرجاء إدخال اسم والمبلغ.", "⚠️ المصروف");
            return;
        }

        if (newExpensePrice > caisseAmount)
        {
            toastService.ShowWarning("المبلغ المطلوب أكبر من رصيد صندوق المبيعات!", "⚠️ المصروف");
            return;
        }

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
            await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount - @Amt, UpdatedAt = @Date", new { Amt = newExpensePrice, Date = dateNow }, transaction);
            await connection.ExecuteAsync("INSERT INTO Expenses (Id, Expn_Name, Expn_Price, Expn_Date, Expn_Notes, UpdatedAt) VALUES (@Id, @Name, @Price, @Date, @Notes, @Date)",
                new { Id = Guid.NewGuid().ToString(), Name = newExpenseName, Price = newExpensePrice, Date = dateNow, Notes = newExpenseNotes }, transaction);

            transaction.Commit();
            showExpenseModal = false;
            toastService.ShowSuccessShort("تم تسجيل المصروف", "✅ المصروف");
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ: " + ex.Message, "❌ المصروف");
        }
    }

    private async Task DeleteExpense(string id)
    {
        if (!authService.IsAdmin) return;
        bool confirm = await JS.InvokeAsync<bool>("confirm", "حذف هذا المصروف سيعيد المبلغ للصندوق (Caisse). متابعة؟");
        if (!confirm) return;

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            var exp = await connection.QueryFirstOrDefaultAsync<ExpenseModel>("SELECT * FROM Expenses WHERE Id = @Id", new { Id = id }, transaction);
            if (exp != null)
            {
                await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount + @Amt", new { Amt = exp.Expn_Price }, transaction);
                await connection.ExecuteAsync("UPDATE Expenses SET IsDeleted = 1 WHERE Id = @Id", new { Id = id }, transaction);
            }
            transaction.Commit();
            toastService.ShowSuccessShort("تم حذف المصروف وإرجاع المبلغ للصندوق", "✅ المصروف");
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ: " + ex.Message, "❌ المصروف");
        }
    }

    public class PeriodStats
    {
        public decimal Sales { get; }
        public decimal Purchases { get; }
        public decimal Returns { get; }
        public decimal Profit { get; }
        public decimal Expenses { get; }
        public decimal NetSales => Sales - Purchases - Returns;
        public PeriodStats(decimal sales, decimal purchases, decimal returns, decimal profit, decimal expenses)
        {
            Sales = sales; Purchases = purchases; Returns = returns; Profit = profit; Expenses = expenses;
        }
    }

