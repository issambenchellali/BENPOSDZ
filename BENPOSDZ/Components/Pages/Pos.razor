</style>

@code {
    private string searchTerm = "";
    private string saleType = "0"; // مفرد للبحث، لكن كل سلة لها نوعها
    
    private IEnumerable<ProductPosModel> searchResults = new List<ProductPosModel>();
    private List<PersonModel> customersList = new List<PersonModel>();
    private CancellationTokenSource? searchCts;

    private bool showAddToCartModal = false;
    private ProductPosModel? selectedProduct;
    private decimal modalPrice = 0;
    private int modalQty = 1;

    private bool showCustomerModal = false;
    private bool showPrintModal = false;
    private string custSearchTerm = "";
    private bool showNewCustomerForm = false;
    private string newCustomerName = ""; private string newCustomerPhone = ""; private string newCustomerAddress = "";
    private string newCustomerRC = ""; private string newCustomerNIF = ""; private string newCustomerNIS = "";
    private decimal newCustomerDebt = 0;

    // متغيرات التبويبات المتعددة
    private List<CartTab> openTabs = new List<CartTab>();
    private string activeTabId = "";

    private CartTab? ActiveCart => openTabs.FirstOrDefault(t => t.Id == activeTabId);

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
        await SearchProductsAsync();
        AddNewTab(); // إنشاء تبويب أول افتراضي
    }

    private void AddNewTab()
    {
        var newTab = new CartTab { Id = Guid.NewGuid().ToString(), TabName = $"فاتورة {openTabs.Count + 1}", CustomerName = "Au Comptoir", SaleType = "0" };
        openTabs.Add(newTab);
        activeTabId = newTab.Id;
    }

    private void SwitchTab(string tabId) => activeTabId = tabId;

    private void CloseTab(string tabId)
    {
        var tab = openTabs.FirstOrDefault(t => t.Id == tabId);
        if (tab != null && !tab.Items.Any())
        {
            openTabs.Remove(tab);
            if (activeTabId == tabId && openTabs.Any()) activeTabId = openTabs.First().Id;
        }
    }

    private async Task LoadCustomersAsync()
    {
        using var connection = dbService.CreateConnection();
        customersList = (await connection.QueryAsync<PersonModel>("SELECT Id, Person_Name, Person_Phone FROM Persons WHERE Person_Type = 1 AND IsDeleted = 0")).ToList();
    }

    private IEnumerable<PersonModel> filteredCustomersList => customersList.Where(c => string.IsNullOrWhiteSpace(custSearchTerm) || (c.Person_Name?.Contains(custSearchTerm) == true) || (c.Person_Phone?.Contains(custSearchTerm) == true)).Take(50);

    private async Task SearchProductsAsync()
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(200, searchCts.Token);
            using var connection = dbService.CreateConnection();
            string sql = string.IsNullOrWhiteSpace(searchTerm) 
                ? "SELECT * FROM Products WHERE IsDeleted = 0 ORDER BY Pro_Name LIMIT 50"
                : "SELECT * FROM Products WHERE IsDeleted = 0 AND (Pro_Name LIKE @Term OR Pro_Barcode LIKE @Term) ORDER BY Pro_Name";
            
            var rawProducts = (await connection.QueryAsync<ProductPosModel>(sql, new { Term = $"%{searchTerm}%" })).ToList();
            
            // تحويل مسار الصورة إلى Base64 للعرض
            foreach (var p in rawProducts)
            {
                p.Pro_Image = imageService.GetImageAsBase64(p.Pro_Image);
            }

            searchResults = rawProducts;
        }
        catch (TaskCanceledException) { }
    }

    private async Task HandleScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            // البحث عن تطابق كامل للباركود
            var product = searchResults.FirstOrDefault(p => p.Pro_Barcode == searchTerm);
            if (product != null)
            {
                if (product.Pro_Qty <= 0) { await JS.InvokeVoidAsync("alert", "هذا المنتج غير متوفر في المخزون."); return; }
                if (ActiveCart == null) return;
                
                decimal price = ActiveCart.SaleType == "0" ? product.Pro_SalePrice_Max : product.Pro_SalePriceG;
                var existingItem = ActiveCart.Items.FirstOrDefault(c => c.ProductId == product.Id && c.Price == price);
                
                if (existingItem != null)
                {
                    if (existingItem.Qty + 1 > product.Pro_Qty) { await JS.InvokeVoidAsync("alert", "لا توجد كمية كافية في المخزون."); return; }
                    existingItem.Qty += 1;
                }
                else
                {
                    ActiveCart.Items.Add(new CartItem { ProductId = product.Id, Pro_Name = product.Pro_Name, Price = price, Qty = 1 });
                }
                
                ActiveCart.PaidAmount = ActiveCart.TotalAmount;
                searchTerm = ""; // مسح البحث لإضافة منتج جديد
                await SearchProductsAsync();
            }
            // إذا لم يجد الباركود، لا يفعل شيئاً (كما طلبت)
        }
    }

    private void OpenAddToCartModal(ProductPosModel product)
    {
        if (product.Pro_Qty <= 0) { JS.InvokeVoidAsync("alert", "غير متوفر."); return; }
        selectedProduct = product;
        modalQty = 1;
        modalPrice = ActiveCart?.SaleType == "0" ? product.Pro_SalePrice_Max : product.Pro_SalePriceG;
        showAddToCartModal = true;
    }

    private void CloseAddToCartModal() => showAddToCartModal = false;

    private async Task ConfirmAddToCart()
    {
        if (ActiveCart == null || selectedProduct == null) return;
        if (modalQty <= 0) { await JS.InvokeVoidAsync("alert", "الكمية غير صالحة."); return; }
        if (modalQty > selectedProduct.Pro_Qty) { await JS.InvokeVoidAsync("alert", "الكمية أكبر من المخزون."); return; }

        var existingItem = ActiveCart.Items.FirstOrDefault(c => c.ProductId == selectedProduct.Id && c.Price == modalPrice);
        if (existingItem != null)
        {
            if (existingItem.Qty + modalQty > selectedProduct.Pro_Qty) { await JS.InvokeVoidAsync("alert", "لا توجد كمية كافية."); return; }
            existingItem.Qty += modalQty;
        }
        else
        {
            ActiveCart.Items.Add(new CartItem { ProductId = selectedProduct.Id, Pro_Name = selectedProduct.Pro_Name, Price = modalPrice, Qty = modalQty });
        }
        ActiveCart.PaidAmount = ActiveCart.TotalAmount;
        CloseAddToCartModal();
    }

    private void ChangeQty(CartItem item, int delta)
    {
        if (ActiveCart == null) return;
        var product = searchResults.FirstOrDefault(p => p.Id == item.ProductId);
        if (delta > 0 && product != null && item.Qty + 1 > product.Pro_Qty) { JS.InvokeVoidAsync("alert", "لا توجد كمية كافية."); return; }
        
        item.Qty += delta;
        if (item.Qty <= 0) ActiveCart.Items.Remove(item);
        ActiveCart.PaidAmount = ActiveCart.TotalAmount;
    }

    private void RemoveFromCart(CartItem item)
    {
        if (ActiveCart != null) ActiveCart.Items.Remove(item);
    }

