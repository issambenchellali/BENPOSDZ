    private async Task Checkout()
    {
        if (ActiveCart == null) return;
        var cart = ActiveCart;
        if (cart.PaidAmount < 0)
        {
            await JS.InvokeVoidAsync("alert", "المبلغ المدفوع لا يمكن أن يكون سالباً.");
            return;
        }
        if (cart.PaidAmount < cart.TotalAmount && cart.CustomerName == "Au Comptoir")
        {
            await JS.InvokeVoidAsync("alert", "البيع النقدي يتطلب دفع المبلغ كاملاً.");
            return;
        }

        decimal unpaidAmount = cart.TotalAmount - cart.PaidAmount;
        if (unpaidAmount < 0) unpaidAmount = 0;

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            string orderId = Guid.NewGuid().ToString();
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");

            await connection.ExecuteAsync(@"INSERT INTO Orders (Id, Order_Type, Order_Date, Person_ID, User_ID, Price, Paid, Unpaid, UpdatedAt, IsSynced, IsDeleted) 
                                            VALUES (@Id, @Type, @Date, @Person, @User, @Price, @Paid, @Unpaid, @UpdatedAt, 0, 0)",
                new { Id = orderId, Type = int.Parse(cart.SaleType), Date = dateNow, Person = string.IsNullOrEmpty(cart.CustomerId) ? "Au Comptoir" : cart.CustomerId, User = authService.CurrentUser?.Id ?? "admin-id", Price = cart.TotalAmount, Paid = cart.PaidAmount, Unpaid = unpaidAmount, UpdatedAt = dateNow }, transaction);

            foreach (var item in cart.Items)
            {
                await connection.ExecuteAsync(@"INSERT INTO Order_Details (Id, Order_ID, Pro_ID, Pro_Qty, Pro_Price, UpdatedAt, IsSynced, IsDeleted) VALUES (@Id, @OrderId, @ProId, @Qty, @Price, @UpdatedAt, 0, 0)",
                    new { Id = Guid.NewGuid().ToString(), OrderId = orderId, ProId = item.ProductId, Qty = item.Qty, Price = item.Price, UpdatedAt = dateNow }, transaction);
				await connection.ExecuteAsync("UPDATE Products SET Pro_Qty = Pro_Qty - @Qty, Pro_Qty_Inv = CASE WHEN Is_Counted = 1 THEN Pro_Qty_Inv - @Qty ELSE Pro_Qty_Inv END WHERE Id = @Id", new { Qty = item.Qty, Id = item.ProductId }, transaction);
            }

            await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount + @Amount, UpdatedAt = @Date", new { Amount = cart.PaidAmount, Date = dateNow }, transaction);

            // دين الزبون يُحسب تلقائياً من الفواتير غير المسدّدة (Orders.Unpaid)

            transaction.Commit();

            bool sellNoPrint = await IsSellNoPrintEnabled();
            if (sellNoPrint)
            {
                toastService.ShowSuccessShort("شكراً على الشراء", "✅ شكراً لكم");
            }
            else
            {
                bool printNow = await JS.InvokeAsync<bool>("confirm", "تم البيع بنجاح! طباعة الوصل؟");
                if (printNow)
                {
                    var printData = new PrintTemplateService.PrintData
                    {
                        DocType = "receipt",
                        Title = "وصل",
                        InvoiceNumber = orderId.Substring(0, 8),
                        Date = dateNow,
                        Customer = cart.CustomerName,
                        Cashier = authService.CurrentUser?.User_FullName ?? authService.CurrentUser?.User_Name ?? "المدير",
                        Items = cart.Items.Select(c => new PrintTemplateService.PrintItem(c.Pro_Name, (decimal)c.Qty, c.Price, c.Price * c.Qty)).ToList(),
                        Total = cart.TotalAmount,
                        Paid = cart.PaidAmount,
                        Debt = unpaidAmount
                    };
                    string html = printService.RenderFullDocument("receipt", printData);
                    await sysPrintService.PrintHtmlAsync(JS, html, true);
                }
            }

            // إزالة التبويب بعد البيع وإنشاء واحد جديد
            openTabs.Remove(cart);
            if (!openTabs.Any()) AddNewTab();
            else activeTabId = openTabs.First().Id;
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            await JS.InvokeVoidAsync("alert", "خطأ: " + ex.Message);
        }
    }

    private async Task<bool> IsSellNoPrintEnabled()
    {
        try
        {
            using var localConn = dbService.CreateLocalConnection();
            return await localConn.QueryFirstOrDefaultAsync<string>("SELECT `Value` FROM AppSettings WHERE `Key` = 'SellNoPrint'") == "true";
        }
        catch { return false; }
    }

