@page "/pos"
@using BENPOSDZ.Services
@using Dapper
@using Microsoft.AspNetCore.Components.Web
@inject DatabaseService dbService
@inject IJSRuntime JS
@inject ImageService imageService
@inject AuthService authService
@inject PrintTemplateService printService
@inject PrintService sysPrintService
@inject ToastService toastService

<div class="pos-container">
    <!-- القسم الأيمن: البحث والمنتجات -->
    <div class="products-section">
        <div class="search-bar">
            <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="SearchProductsAsync" placeholder="🔍 ابحث أو امسح الباركود..." @onkeydown="HandleScanKey" autofocus/>
        </div>
        
        <div class="products-grid">
            @foreach (var product in searchResults)
            {
                <div class="product-card" @onclick="() => OpenAddToCartModal(product)">
                    <div class="product-name">@product.Pro_Name</div>
                    <div class="product-price">@(saleType == "0" ? product.Pro_SalePrice_Max : product.Pro_SalePriceG) د.ج</div>
                    <div class="product-stock">المخزون: @product.Pro_Qty</div>
                </div>
            }
        </div>
    </div>

    <!-- القسم الأيسر: التبويبات والسلة -->
    <div class="cart-section">
        <!-- شريط التبويبات -->
        <div class="tabs-header">
            @foreach (var tab in openTabs)
            {
                <div class="tab-item @(activeTabId == tab.Id ? "active" : "")" @onclick="() => SwitchTab(tab.Id)">
                    <span>@tab.TabName</span>
                    @if (openTabs.Count > 1)
                    {
                        <button class="close-tab" @onclick="() => CloseTab(tab.Id)" @onclick:stopPropagation="true">x</button>
                    }
                </div>
            }
            <button class="add-tab-btn" @onclick="AddNewTab">+ فاتورة</button>
        </div>

        @if (ActiveCart != null)
        {
            <div class="pos-top-bar">
                <select @bind="ActiveCart.SaleType" class="sale-type-select">
                    <option value="0">تجزئة</option>
                    <option value="1">جملة</option>
                </select>
                <div class="customer-box" @onclick="OpenCustomerSearchModal">
                    <span>👤 @(string.IsNullOrEmpty(ActiveCart.CustomerName) ? "Au Comptoir" : ActiveCart.CustomerName)</span>
                </div>
                <button class="print-cart-btn" @onclick="() => showPrintModal = true" title="طباعة فاتورة / BL / وصل قبل البيع">🖨️ طباعة</button>
            </div>

            @if (!string.IsNullOrEmpty(ActiveCart.CustomerId))
            {
                <div class="customer-actions-bar">
                    <span class="cust-debt-label">دين <b>@ActiveCart.CustomerName</b>:
                        <span class="cust-debt-value @(selectedCustomerDebt > 0 ? "negative" : "")">@selectedCustomerDebt.ToString("0.00") د.ج</span>
                    </span>
                    <button class="cust-act-btn hist" @onclick="OpenCustomerHistoryModal">📜 فواتيره القديمة</button>
                    <button class="cust-act-btn pay" @onclick="OpenCustomerPayModal">💵 تسديد الدين</button>
                </div>
            }

            <div class="cart-items">
                @if (!ActiveCart.Items.Any())
                {
                    <p class="empty-cart">السلة فارغة.</p>
                }
                else
                {
                    @foreach (var item in ActiveCart.Items)
                    {
                        <div class="cart-item">
                            <span class="cart-item-name">@item.Pro_Name</span>
                            <div class="cart-item-controls">
                                <button @onclick="() => ChangeQty(item, -1)">-</button>
                                <span>@item.Qty</span>
                                <button @onclick="() => ChangeQty(item, 1)">+</button>
                                <span class="cart-item-total">@((item.Price * item.Qty).ToString("0.00")) د.ج</span>
                                <button class="remove-btn" @onclick="() => RemoveFromCart(item)">x</button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="cart-summary">
                <div class="total-row">
                    <h2>المجموع:</h2>
                    <h2 class="total-amount">@ActiveCart.TotalAmount.ToString("0.00") د.ج</h2>
                </div>
                
                <div class="payment-section">
                    <label>المبلغ المدفوع:</label>
                    <input type="number" @bind="ActiveCart.PaidAmount" class="paid-input" min="0" />
                    <small>الصرف (Reste): @((ActiveCart.PaidAmount - ActiveCart.TotalAmount).ToString("0.00")) د.ج</small>
                </div>

                <button class="checkout-btn" disabled="@(!ActiveCart.Items.Any())" @onclick="Checkout">إتمام البيع (F10)</button>
            </div>
        }
    </div>
</div>

<!-- نافذة إضافة للسلة -->
@if (showAddToCartModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h3>@selectedProduct?.Pro_Name</h3>
            <img src="@(string.IsNullOrEmpty(selectedProduct?.Pro_Image) ? "https://via.placeholder.com/150" : selectedProduct.Pro_Image)" class="prod-modal-img" />
            <div class="form-row">
                <div class="form-group">
                    <label>السعر (دج)</label>
                    <input type="number" @bind="modalPrice" min="0" />
                </div>
                <div class="form-group">
                    <label>الكمية (متوفر: @selectedProduct?.Pro_Qty)</label>
                    <input type="number" @bind="modalQty" min="1" max="@selectedProduct?.Pro_Qty" />
                </div>
            </div>
            <p class="price-hint">يمكنك تعديل السعر ضمن الحدود المسموحة.</p>
            <div class="modal-actions">
                <button class="btn-save" @onclick="ConfirmAddToCart">إضافة للسلة</button>
                <button class="btn-cancel" @onclick="CloseAddToCartModal">إلغاء</button>
            </div>
        </div>
    </div>
}

<!-- نافذة إدارة العملاء (نفس الكود السابق) -->
@if (showCustomerModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 600px;">
            <h3>إدارة العملاء</h3>
            <div class="cust-search-row">
                <input type="text" @bind="custSearchTerm" @bind:event="oninput" placeholder="🔍 ابحث بالاسم أو الهاتف..." class="cust-search-input"/>
                <button class="btn-add-new-cust" @onclick="ToggleNewCustomerForm">+ زبون جديد</button>
            </div>
            @if (showNewCustomerForm)
            {
                <div class="new-cust-form">
                    <div class="form-row">
                        <input type="text" @bind="newCustomerName" placeholder="الاسم الكامل *"/>
                        <input type="text" @bind="newCustomerPhone" placeholder="رقم الهاتف"/>
                    </div>
                    <div class="form-row">
                        <input type="text" @bind="newCustomerAddress" placeholder="العنوان"/>
                        <input type="text" @bind="newCustomerRC" placeholder="RC"/>
                    </div>
                    <div class="form-row">
                        <input type="text" @bind="newCustomerNIF" placeholder="NIF"/>
                        <input type="text" @bind="newCustomerNIS" placeholder="NIS"/>
                    </div>
                    <div class="form-row">
                        <input type="number" @bind="newCustomerDebt" min="0" step="0.01" placeholder="الدين السابق (د.ج)"/>
                    </div>
                    <button class="btn-save" @onclick="SaveCustomer">حفظ</button>
                </div>
            }
            <div class="cust-list">
                @foreach (var cust in filteredCustomersList)
                {
                    <div class="cust-item" @onclick="() => SelectCustomer(cust.Id, cust.Person_Name)">
                        <span>@cust.Person_Name</span>
                        <small>@cust.Person_Phone</small>
                    </div>
                }
            </div>
            <button class="btn-cancel" @onclick="() => showCustomerModal = false" style="width:100%; margin-top:10px;">إغلاق</button>
        </div>
    </div>
}

<!-- نافذة اختيار نوع الطباعة -->
@if (showPrintModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 420px;">
            <h3>🖨️ طباعة الوثيقة</h3>
            <p class="print-hint">يمكنك الطباعة في أي وقت — حتى قبل إتمام البيع (وثيقة فارغة).</p>
            <div class="print-options">
                <button class="print-opt invoice" @onclick='() => PrintCurrentCart("invoice")'>📄 فاتورة</button>
                <button class="print-opt delivery" @onclick='() => PrintCurrentCart("delivery")'>🚚 بون تسليم (BL)</button>
                <button class="print-opt receipt" @onclick='() => PrintCurrentCart("receipt")'>🧾 وصل</button>
            </div>
            <button class="btn-cancel" @onclick="() => showPrintModal = false" style="width:100%; margin-top:10px;">إلغاء</button>
        </div>
    </div>
}

<!-- نافذة الفواتير القديمة للزبون -->
@if (showCustomerHistoryModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 720px;">
            <h3>📜 فواتير الزبون: @customerHistoryName</h3>
            @if (!customerInvoices.Any())
            {
                <p class="print-hint">لا توجد فواتير سابقة لهذا الزبون.</p>
            }
            else
            {
                <table class="hist-table">
                    <thead>
                        <tr><th>التاريخ</th><th>النوع</th><th>المبلغ</th><th>المدفوع</th><th>الدين</th><th>طباعة</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in customerInvoices)
                        {
                            <tr>
                                <td>@inv.Order_Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@GetTypeName(inv.Order_Type)</td>
                                <td>@inv.Price.ToString("0.00") د.ج</td>
                                <td>@inv.Paid.ToString("0.00") د.ج</td>
                                <td class="@(inv.Unpaid > 0 ? "debt-color" : "")">@inv.Unpaid.ToString("0.00") د.ج</td>
                                <td><button class="btn-print-sm" @onclick="() => PrintCustomerInvoice(inv.Id)">🖨️</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <button class="btn-cancel" @onclick="() => showCustomerHistoryModal = false" style="width:100%; margin-top:10px;">إغلاق</button>
        </div>
    </div>
}

<!-- نافذة تسديد الدين -->
@if (showCustomerPayModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 430px;">
            <h3>💵 تسديد دين</h3>
            <p class="print-hint">الدين الحالي لـ <strong>@ActiveCart?.CustomerName</strong>: @selectedCustomerDebt.ToString("0.00") د.ج</p>
            <div class="form-group">
                <label>المبلغ المدفوع</label>
                <input type="number" @bind="payAmount" min="0" max="@selectedCustomerDebt" />
            </div>
            <p class="hint">سيتم إضافة المبلغ للصندوق (Caisse) وتوزيعه على أقدم الفواتير أولاً.</p>
            <div class="modal-actions">
                <button class="btn-save" @onclick="ConfirmCustomerPayment">تأكيد التسديد</button>
                <button class="btn-cancel" @onclick="() => showCustomerPayModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

