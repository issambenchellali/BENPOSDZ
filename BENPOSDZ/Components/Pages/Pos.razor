    private async Task LoadCustomerDebtAsync(string id)
    {
        selectedCustomerDebt = 0;
        try
        {
            using var connection = dbService.CreateConnection();
            selectedCustomerDebt = await connection.ExecuteScalarAsync<decimal>(@"
                SELECT COALESCE(p.Person_Debt, 0) +
                       COALESCE((SELECT SUM(o.Unpaid) FROM Orders o WHERE o.Person_ID = @Id AND o.IsDeleted = 0 AND o.Unpaid > 0 AND o.Order_Type IN (0,1,2)), 0)
                FROM Persons p WHERE p.Id = @Id", new { Id = id });
        }
