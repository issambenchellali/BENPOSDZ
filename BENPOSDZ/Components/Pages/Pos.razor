    // نافذة تسديد الدين
    private bool showCustomerPayModal = false;
    private string payCustomerId = "";
    private decimal payAmount = 0;

    private void OpenCustomerPayModal()
    {
        if (ActiveCart == null || string.IsNullOrEmpty(ActiveCart.CustomerId)) return;
        payCustomerId = ActiveCart.CustomerId;
        payAmount = selectedCustomerDebt;
        showCustomerPayModal = true;
    }

    private async Task ConfirmCustomerPayment()
    {
        if (string.IsNullOrEmpty(payCustomerId) || payAmount <= 0 || payAmount > selectedCustomerDebt) return;

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            // 1. توزيع المبلغ على الفواتير غير المدفوعة (أقدم فاتورة أولاً)
            var unpaidInvoices = (await connection.QueryAsync<InvoiceModel>("SELECT * FROM Orders WHERE Person_ID = @Id AND Unpaid > 0 AND IsDeleted = 0 AND Order_Type IN (0,1,2) ORDER BY Order_Date ASC", new { Id = payCustomerId }, transaction)).ToList();
            decimal remaining = payAmount;
            foreach (var inv in unpaidInvoices)
            {
                if (remaining <= 0) break;
                decimal amountToPay = Math.Min(remaining, inv.Unpaid);
                await connection.ExecuteAsync("UPDATE Orders SET Paid = Paid + @Pay, Unpaid = Unpaid - @Pay WHERE Id = @Id", new { Pay = amountToPay, Id = inv.Id }, transaction);
                remaining -= amountToPay;
            }

            // 2. المبلغ المتبقي يخصم من الدين الأساسي
            if (remaining > 0)
            {
                await connection.ExecuteAsync("UPDATE Persons SET Person_Debt = CASE WHEN Person_Debt >= @Amt THEN Person_Debt - @Amt ELSE 0 END WHERE Id = @Id", new { Amt = remaining, Id = payCustomerId }, transaction);
            }

            // 3. إضافة المال للصندوق
            await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount + @Amt", new { Amt = payAmount }, transaction);

            transaction.Commit();
            toastService.ShowSuccessShort("تم تسديد الدين بنجاح وتحديث الفواتير!", "✅ الدفع");
            showCustomerPayModal = false;
            await LoadCustomerDebtAsync(payCustomerId);
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ: " + ex.Message, "❌ الدفع");
        }
    }

    private async Task PrintCustomerInvoice(string invId)
    {
        try
        {
            using var connection = dbService.CreateConnection();
            var inv = await connection.QueryFirstOrDefaultAsync<dynamic>("SELECT o.*, p.Person_Name, u.User_FullName, u.User_Name FROM Orders o LEFT JOIN Persons p ON o.Person_ID = p.Id LEFT JOIN Users u ON o.User_ID = u.Id WHERE o.Id = @Id", new { Id = invId });
            if (inv == null) return;

            var details = await connection.QueryAsync<dynamic>(@"SELECT p.Pro_Name, od.Pro_Qty, od.Pro_Price FROM Order_Details od JOIN Products p ON od.Pro_ID = p.Id WHERE od.Order_ID = @Id", new { Id = invId });

            string cashierName = inv.User_FullName != null ? (string)inv.User_FullName : (inv.User_Name != null ? (string)inv.User_Name : "");
            if (string.IsNullOrWhiteSpace(cashierName))
                cashierName = authService.CurrentUser?.User_FullName ?? authService.CurrentUser?.User_Name ?? "المدير";

            var data = new PrintTemplateService.PrintData
            {
                DocType = "invoice",
                Title = "فاتورة",
                InvoiceNumber = invId.Substring(0, 8),
                Date = Convert.ToDateTime(inv.Order_Date).ToString("yyyy-MM-dd HH:mm"),
                Customer = (string)(inv.Person_Name ?? "Au Comptoir"),
                Cashier = cashierName,
                Items = details.Select(d => new PrintTemplateService.PrintItem((string)d.Pro_Name, (decimal)d.Pro_Qty, (decimal)d.Pro_Price, (decimal)(d.Pro_Qty * d.Pro_Price))).ToList(),
                Total = (decimal)inv.Price, Paid = (decimal)inv.Paid, Debt = (decimal)inv.Unpaid
            };
            string html = printService.RenderFullDocument("invoice", data);
            await sysPrintService.PrintHtmlAsync(JS, html, false);
        }
        catch (Exception ex)
        {
            toastService.ShowError("خطأ في الطباعة: " + ex.Message, "❌ الطباعة");
        }
    }

