@page "/"
@page "/login"
@layout BENPOSDZ.Components.Layout.EmptyLayout
@using BENPOSDZ.Services
@using Dapper
@inject DatabaseService dbService
@inject SecurityService securityService
@inject AuthService authService
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@inject IApplicationStateService appState
@inject IJSRuntime JS

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1>BEN POS</h1>
            <p>نظام إدارة المبيعات</p>
        </div>

        @if (showForceChange)
        {
            <div class="force-change-box">
                <h3>🔒 تغيير كلمة المرور الافتراضية</h3>
                <p>لأمان النظام، يجب تغيير كلمة مرور المسؤول الافتراضية قبل المتابعة.</p>
                <div class="form-group">
                    <label for="newPass">كلمة المرور الجديدة</label>
                    <input id="newPass" type="password" @bind="newPass" placeholder="4 أحرف على الأقل" />
                </div>
                <div class="form-group">
                    <label for="confirmNewPass">تأكيد كلمة المرور</label>
                    <input id="confirmNewPass" type="password" @bind="confirmNewPass" placeholder="أعد كتابة كلمة المرور" />
                </div>
                @if (passError != null)
                {
                    <div class="error-message">@passError</div>
                }
                <button type="button" class="btn-login" @onclick="ChangePasswordNow">حفظ وتغيير</button>
            </div>
        }
        else
        {
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="login-form">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label for="username">اسم المستخدم</label>
                <InputText id="username" @bind-Value="loginModel.Username" placeholder="أدخل اسم المستخدم" />
                <ValidationMessage For="@(() => loginModel.Username)" />
            </div>

            <div class="form-group">
                <label for="password">كلمة المرور</label>
                <InputText id="password" type="password" @bind-Value="loginModel.Password" placeholder="أدخل كلمة المرور" />
                <ValidationMessage For="@(() => loginModel.Password)" />
            </div>

            @if (errorMessage != null)
            {
                <div class="error-message">@errorMessage</div>
            }
			<div class="form-group">
				<label>وضع قاعدة البيانات:</label>
				<div class="db-mode-row">
					<button type="button" class="btn-db-mode @(dbMode == "Local" ? "active" : "")" @onclick='() => ChangeDbMode("Local")'>💻 محلي (SQLite)</button>
					<button type="button" class="btn-db-mode @(dbMode == "LAN" ? "active" : "")" @onclick='() => ChangeDbMode("LAN")'>🌐 شبكة (MySQL)</button>
					<button type="button" class="btn-toggle-conn @(showConnSettings ? "active" : "")" @onclick="() => showConnSettings = !showConnSettings" title="إعدادات الاتصال المتقدمة">
						⚙️ إعدادات الاتصال
					</button>
				</div>
			</div>
			<div class="conn-settings">
				@if (showConnSettings)
				{
					<div class="conn-settings-box">
						@if (dbMode == "LAN")
						{
							<div class="form-group">
								<label>عنوان خادم MySQL (Host أو IP)</label>
								<input type="text" @bind="connHost" placeholder="مثال: BEN-SERVER أو 192.168.1.10" />
							</div>
							<div class="form-row">
								<div class="form-group"><label>المستخدم</label><input type="text" @bind="connUser" /></div>
								<div class="form-group"><label>كلمة المرور</label><input type="password" @bind="connPass" /></div>
							</div>
						}
						<div class="form-group">
							<label>تفعيل المزامنة السحابية (Supabase)</label>
							<select @bind="connCloudSync">
								<option value="false">معطلة</option>
								<option value="true">مفعلة</option>
							</select>
						</div>
						<div class="form-group">
							<label>Supabase URL</label>
							<input type="text" @bind="connSupabaseUrl" placeholder="https://xxxx.supabase.co" />
						</div>
						<div class="form-group">
							<label>Supabase Key</label>
							<input type="password" @bind="connSupabaseKey" placeholder="مفتاح سرّي" />
						</div>
						<div class="conn-actions">
							<button type="button" class="btn-save-conn" @onclick="SaveConnSettings">💾 حفظ الإعدادات</button>
						</div>
					</div>
				}
			</div>
            <button type="submit" class="btn-login">تسجيل الدخول</button>
        </EditForm>
        }
		<div class="connection-status-login">
			<small style="color:@(appState.ConnectionStatus.Contains("🟢") ? "#10b981" : "#ef4444"); font-weight: bold;">
				@appState.ConnectionStatus
			</small>
		</div>
        <!-- صندوق سجل أخطاء الدخول (Architecture Log Viewer) -->
        @if (showLogs)
        {
            <div class="log-viewer">
                <h4>سجل العمليات الخلفية (System Log)</h4>
                <textarea readonly>@dbService.SystemLog</textarea>
            </div>
        }
        <button class="btn-toggle-logs" @onclick="() => showLogs = !showLogs">عرض/إخفاء السجل التقني</button>
        <div class="default-accounts-note">
            <small>الحساب الافتراضي للمدير: <strong>admin / 123</strong> — للبائع: <strong>123 / 123</strong></small>
        </div>
    </div>
</div>

<style>
    .login-container { display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .login-card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); width: 400px; text-align: center; direction: rtl; }
    .login-header h1 { color: #007bff; margin-bottom: 5px; }
    .login-header p { color: #666; margin-top: 0; margin-bottom: 30px; }
    .form-group { margin-bottom: 20px; text-align: right; }
    .form-group label { display: block; margin-bottom: 5px; color: #333; font-weight: bold; }
    .form-group input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; font-size: 16px; }
    .btn-login { width: 100%; padding: 12px; background-color: #007bff; color: white; border: none; border-radius: 6px; font-size: 18px; cursor: pointer; transition: background-color 0.3s; }
    .btn-login:hover { background-color: #0056b3; }
    .error-message { color: #dc3545; margin-bottom: 15px; font-size: 14px; background: #fee2e2; padding: 10px; border-radius: 6px; }
    .log-viewer { margin-top: 20px; text-align: right; }
    .log-viewer h4 { font-size: 14px; color: #666; margin-bottom: 5px; }
    .log-viewer textarea { width: 100%; height: 100px; font-family: monospace; font-size: 11px; background: #1e293b; color: #94a3b8; border: none; border-radius: 6px; padding: 10px; resize: none; box-sizing: border-box; }
    .btn-toggle-logs { background: none; border: none; color: #6c757d; font-size: 12px; cursor: pointer; margin-top: 10px; }
    .btn-toggle-logs:hover { text-decoration: underline; }
	.connection-status-login { text-align: center; margin-top: 15px; }
	.db-mode-row { display: flex; gap: 10px; align-items: center; }
    .db-mode-row .btn-db-mode { flex: 1; }
    .btn-db-mode { padding: 10px; border: 2px solid #e2e8f0; background: #fff; border-radius: 8px; cursor: pointer; font-weight: bold; color: #64748b; transition: 0.2s; }
    .btn-db-mode.active { border-color: #007bff; background: #eef6ff; color: #007bff; }
    .conn-settings { margin-top: 15px; }
    .btn-toggle-conn { flex: 0 0 auto; padding: 10px 14px; background: #f8f9fa; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; font-weight: bold; color: #334155; white-space: nowrap; }
    .btn-toggle-conn:hover, .btn-toggle-conn.active { background: #eef6ff; border-color: #007bff; color: #007bff; }
    .conn-settings-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-top: 10px; text-align: right; }
    .conn-settings-box .form-group { margin-bottom: 12px; }
    .conn-settings-box select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
    .conn-actions { display: flex; gap: 10px; }
    .btn-save-conn { flex: 1; padding: 10px; background: #007bff; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
    .default-accounts-note { margin-top: 12px; color: #888; font-size: 12px; text-align: center; }
    .form-row { display: flex; gap: 10px; }
    .form-row .form-group { flex: 1; }
</style>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? errorMessage;
    private bool showLogs = false;

    private bool showForceChange = false;
    private string newPass = "";
    private string confirmNewPass = "";
    private string? passError;

    private async Task ChangePasswordNow()
    {
        passError = null;
        if (newPass.Length < 4) { passError = "كلمة المرور قصيرة جداً (4 أحرف على الأقل)."; return; }
        if (newPass == "123") { passError = "لا يمكن استخدام كلمة المرور الافتراضية."; return; }
        if (newPass != confirmNewPass) { passError = "كلمتا المرور غير متطابقتين."; return; }

        try
        {
            string hash = securityService.HashPassword(newPass);
            using var connection = dbService.CreateConnection();
            await connection.ExecuteAsync("UPDATE Users SET User_Password = @Pass WHERE Id = @Id", new { Pass = hash, Id = authService.CurrentUser?.Id });
            dbService.LogEvent("🔒 تم تغيير كلمة مرور المسؤول الافتراضية.");
            Navigation.NavigateTo("/pos");
        }
        catch (Exception ex)
        {
            passError = "فشل تغيير كلمة المرور: " + ex.Message;
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        try
        {
            // المصادقة من قاعدة البيانات النشطة فقط (SQLite في الوضع المحلي، MySQL في وضع LAN)
            AuthService.UserModel? user;
            using (var connection = dbService.CreateConnection())
            {
                string sql = "SELECT * FROM Users WHERE User_Name = @Username AND IsDeleted = 0;";
                user = await connection.QueryFirstOrDefaultAsync<AuthService.UserModel>(sql, new { loginModel.Username });
            }

            if (user != null && securityService.VerifyPassword(loginModel.Password, user.User_Password))
            {
                // ترقية الهاش القديم (SHA256) إلى PBKDF2 عند أول تسجيل دخول ناجح
                if (securityService.IsLegacyHash(user.User_Password))
                {
                    string newHash = securityService.HashPassword(loginModel.Password);
                    using var connection = dbService.CreateConnection();
                    await connection.ExecuteAsync("UPDATE Users SET User_Password = @Pass WHERE Id = @Id", new { Pass = newHash, user.Id });
                    dbService.LogEvent("🔒 تمت ترقية هاش كلمة مرور المستخدم إلى PBKDF2.");
                }

                authService.Login(user);
                if (user.User_Name == "admin" && loginModel.Password == "123")
                {
                    // تغيير إجباري لكلمة مرور المسؤول الافتراضية بعد أول دخول
                    showForceChange = true;
                    passError = null;
                    newPass = "";
                    confirmNewPass = "";
                }
                else
                {
                    Navigation.NavigateTo("/pos");
                }
            }
            else
            {
                errorMessage = "اسم المستخدم أو كلمة المرور غير صحيحة.";
                dbService.SystemLog = $"[{DateTime.Now:HH:mm:ss}] فشل محاولة دخول للمستخدم: {loginModel.Username}\n" + dbService.SystemLog;
            }
        }
        catch (Exception ex)
        {
            // الحماية الصارمة من الانهيار
            errorMessage = "حدث خطأ تقني غير متوقع أثناء الاتصال بقاعدة البيانات. يرجى مراجعة السجل.";
            dbService.SystemLog = $"[{DateTime.Now:HH:mm:ss}] ❌ Login Exception: {ex.Message}\n" + dbService.SystemLog;
            showLogs = true; // إظهار السجل تلقائياً عند حدوث خطأ
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "اسم المستخدم مطلوب")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "كلمة المرور مطلوبة")]
        public string Password { get; set; } = string.Empty;
    }
	
	private string dbMode = "Local";
	private bool showConnSettings = false;
	private string connHost = "";
	private string connUser = "";
	private string connPass = "";
	private string connCloudSync = "false";
	private string connSupabaseUrl = "";
	private string connSupabaseKey = "";

    protected override void OnInitialized()
    {
        // قراءة آخر وضع اتصال محفوظ
        using var connection = dbService.CreateLocalConnection();
        dbMode = connection.QueryFirstOrDefault<string>("SELECT `Value` FROM AppSettings WHERE `Key` = 'DBMode'") ?? "Local";
        LoadConnSettings();
        // مزامنة حالة الاتصال الفعلية (كانت تعرض "SQLite" بشكل خاطئ حتى في وضع LAN)
        appState.SetConnectionStatus(dbService.ConnectionStatus);
    }

    private void LoadConnSettings()
    {
        using var connection = dbService.CreateLocalConnection();
        var settings = connection.Query<dynamic>("SELECT * FROM AppSettings").ToDictionary(x => (string)x.Key, x => (string)x.Value);
        connHost = settings.ContainsKey("MySQL_Host") ? settings["MySQL_Host"] : "127.0.0.1";
        connUser = settings.ContainsKey("MySQL_User") ? settings["MySQL_User"] : "root";
        connPass = settings.ContainsKey("MySQL_Pass") ? SecretProtector.Decrypt(settings["MySQL_Pass"]) : "";
        connCloudSync = settings.ContainsKey("CloudSyncEnabled") ? settings["CloudSyncEnabled"] : "false";
        connSupabaseUrl = settings.ContainsKey("SupabaseURL") ? settings["SupabaseURL"] : "";
        connSupabaseKey = settings.ContainsKey("SupabaseKey") ? SecretProtector.Decrypt(settings["SupabaseKey"]) : "";
    }

    private void SaveConnSettings()
    {
        try
        {
            using var connection = dbService.CreateLocalConnection();
            void Set(string key, string val)
            {
                var ra = connection.Execute("UPDATE AppSettings SET `Value` = @V WHERE `Key` = @K", new { V = val, K = key });
                if (ra == 0) connection.Execute("INSERT INTO AppSettings (`Key`, `Value`) VALUES (@K, @V)", new { V = val, K = key });
            }
            Set("MySQL_Host", connHost);
            Set("MySQL_User", connUser);
            Set("MySQL_Pass", SecretProtector.Encrypt(connPass));
            Set("CloudSyncEnabled", connCloudSync);
            Set("SupabaseURL", connSupabaseUrl);
            Set("SupabaseKey", SecretProtector.Encrypt(connSupabaseKey));

            dbService.ReloadSettings();
            appState.SetConnectionStatus(dbService.ConnectionStatus);
            errorMessage = null;
            showConnSettings = false;
            dbService.LogEvent("✅ تم حفظ إعدادات الاتصال من شاشة الدخول.");
        }
        catch (Exception ex)
        {
            errorMessage = "فشل حفظ الإعدادات: " + ex.Message;
        }
    }

    private void ChangeDbMode(string mode)
    {
        dbMode = mode;
        using var connection = dbService.CreateLocalConnection();
        // حفظ الوضع الجديد فوراً
        var rowsAffected = connection.Execute("UPDATE AppSettings SET `Value` = @Mode WHERE `Key` = 'DBMode'", new { Mode = mode });
        if (rowsAffected == 0)
        {
            connection.Execute("INSERT INTO AppSettings (`Key`, `Value`) VALUES ('DBMode', @Mode)", new { Mode = mode });
        }
        
        // إعادة تحميل إعدادات الاتصال في الذاكرة
        dbService.ReloadSettings();
        appState.SetConnectionStatus(dbService.ConnectionStatus);
    }
}