        sb.AppendLine("<!DOCTYPE html><html dir='rtl' lang='ar'><head><meta charset='utf-8'/><title>قائمة المنتجات</title><style>");
        sb.AppendLine("body{font-family:Arial,sans-serif;direction:rtl;padding:15mm;}h2{text-align:center;}p.date{text-align:center;color:#555;margin-top:0;}table{width:100%;border-collapse:collapse;margin-top:15px;}th,td{border:1px solid #000;padding:8px;text-align:right;}th{background:#eee;}");
        sb.AppendLine("</style></head><body>");
        sb.AppendLine("<h2>قائمة المنتجات</h2>");
        sb.AppendLine($"<p class='date'>التاريخ: {DateTime.Now:yyyy-MM-dd HH:mm}</p>");
        sb.AppendLine("<table><thead><tr><th>السلعة</th><th>الكمية</th>");
