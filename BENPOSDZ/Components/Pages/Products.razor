        if (printColWhole) sb.AppendLine("<th>سعر الجملة</th>");
        if (printColRetailMin) sb.AppendLine("<th>تجزئة (أدنى)</th>");
        if (printColRetailMax) sb.AppendLine("<th>تجزئة (أعلى)</th>");
        sb.AppendLine("</tr></thead><tbody>");
        foreach (var p in data)
        {
            sb.AppendLine($"<tr><td>{System.Net.WebUtility.HtmlEncode(p.name)}</td><td>{p.qty:0.##}</td>");
            if (printColBuy) sb.AppendLine($"<td>{p.buy:0.00}</td>");
            if (printColWhole) sb.AppendLine($"<td>{p.whole:0.00}</td>");
            if (printColRetailMin) sb.AppendLine($"<td>{p.min:0.00}</td>");
            if (printColRetailMax) sb.AppendLine($"<td>{p.max:0.00}</td>");
            sb.AppendLine("</tr>");
        }
        sb.AppendLine("</tbody></table></body></html>");
        try
        {
            await sysPrintService.PrintHtmlAsync(JS, sb.ToString(), false);
            toastService.ShowSuccess("تم فتح قائمة الأسعار للطباعة", "🖨️ طباعة الأسعار");
        }
        catch (Exception ex)
        {
            toastService.ShowError("تعذر طباعة قائمة الأسعار: " + ex.Message, "❌ طباعة الأسعار");
        }
    }

    // تحديث دالة ApplyInventory لتقوم بالتصفير بعد التطبيق
    private async Task ApplyInventory()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد؟ سيتم استبدال الكمية الحالية بالكمية المعدودة للسلع المعلّمة، وسيتم تصفير حقل الجرد بعدها.");
        if (!confirm) return;

        var countedItems = productsList.Where(p => p.Is_Counted).ToList();
        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            foreach (var item in countedItems)
            {
                await connection.ExecuteAsync("UPDATE Products SET Pro_Qty = @InvQty WHERE Id = @Id", new { InvQty = item.Pro_Qty_Inv, item.Id }, transaction);
            }
            // تصفير حقل الجرد وإلغاء التفعيل لكل المنتجات بعد التطبيق
            await connection.ExecuteAsync("UPDATE Products SET Pro_Qty_Inv = 0, Is_Counted = 0", transaction: transaction);

            transaction.Commit();
            toastService.ShowSuccess($"تم تحديث كميات {countedItems.Count} سلعة بنجاح، وتصفير حقل الجرد", "✅ تطبيق الجرد");
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ أثناء تطبيق الجرد: " + ex.Message, "❌ تطبيق الجرد");
        }
    }
