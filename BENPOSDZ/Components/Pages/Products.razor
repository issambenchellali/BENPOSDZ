    @@media (max-width: 768px) {
        .top-bar { flex-wrap: wrap; gap: 8px; }
        .top-bar .search-input { width: 100%; min-height: 44px; font-size: 16px; }
        .top-bar button { flex: 1 1 auto; min-width: 48px; min-height: 48px; font-size: 15px; }
        .btn-edit, .btn-delete, .btn-print { min-width: 48px; min-height: 48px; font-size: 15px; }
        .products-table th, .products-table td { padding: 8px; }
    }
</style>

@code {
    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] AuthService authService { get; set; } = null!;
	
	    // متغيرات نافذة الطباعة
    private bool showPrintModal = false;
    private bool printOnlyAvailable = false;
    private bool printColBuy = false;
    private bool printColWhole = false;
    private bool printColRetailMin = false;
    private bool printColRetailMax = false;
	private bool printColQty = true;
	
    protected override void OnInitialized()
    {

    }
    private string searchTerm = "";
    private IEnumerable<ProductViewModel> productsList = new List<ProductViewModel>();
    private List<ProductViewModel> lowStockItems = new List<ProductViewModel>();
    private string loadError = "";
    private bool showModal = false;
    private bool isEditing = false;
    private bool hasExpiration = false;
    private string? previewImage = "";
    private ProductInputModel newProduct = new ProductInputModel();
    private CancellationTokenSource? searchCts;

    private async Task LoadProductsAsync()
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        loadError = "";
        try
        {
            await Task.Delay(200, searchCts.Token);
            using var connection = dbService.CreateConnection();
            string sql = string.IsNullOrWhiteSpace(searchTerm) 
                ? "SELECT * FROM Products WHERE IsDeleted = 0 ORDER BY Pro_Name"
                : @"SELECT * FROM Products 
                    WHERE IsDeleted = 0 AND 
                    (Pro_Name LIKE @Term OR Pro_Mark LIKE @Term OR Pro_Propr LIKE @Term OR Pro_Barcode LIKE @Term) 
                    ORDER BY Pro_Name";
            
            var rawProducts = (await connection.QueryAsync<ProductViewModel>(sql, new { Term = $"%{searchTerm}%" })).ToList();
            
            // تحويل مسار الملف إلى Base64 للعرض في الواجهة
            foreach (var p in rawProducts)
            {
                p.Pro_Image = imageService.GetImageAsBase64(p.Pro_Image);
            }

            productsList = rawProducts;
            lowStockItems = productsList.Where(p => p.Pro_QtyMin > 0 && p.Pro_Qty <= p.Pro_QtyMin).ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            loadError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadProducts()
    {
        loadError = "";
        await LoadProductsAsync();
        toastService.ShowSuccess("تمت إعادة تحميل المنتجات", "📦 المنتجات");
    }

    private void OpenAddModal()
    {
        isEditing = false;
        newProduct = new ProductInputModel();
        hasExpiration = false;
        previewImage = "";
        showModal = true;
    }

    private void EditProduct(ProductViewModel product)
    {
        isEditing = true;
        newProduct = new ProductInputModel
        {
            Id = product.Id,
            Pro_Name = product.Pro_Name,
            Pro_Mark = product.Pro_Mark ?? "",
            Pro_Propr = product.Pro_Propr ?? "",
            Pro_Unit = product.Pro_Unit ?? "",
			Pro_Type_ID = product.Pro_Type_ID ?? "", // <--- تأكد أن هذا السطر موجود
            Pro_Barcode = product.Pro_Barcode ?? "",
            Pro_Qty = product.Pro_Qty,
            Pro_QtyMin = product.Pro_QtyMin,
            Pro_BuyPrice = product.Pro_BuyPrice,
            Pro_SalePriceG = product.Pro_SalePriceG,
            Pro_SalePrice_Min = product.Pro_SalePrice_Min,
            Pro_SalePrice_Max = product.Pro_SalePrice_Max,
            Pro_date_exp = string.IsNullOrEmpty(product.Pro_date_exp) ? (DateTime?)null : DateTime.Parse(product.Pro_date_exp),
            Pro_Image = product.Pro_Image ?? "" // <--- تم إضافة ?? "" لمنع التحذير
        };
        hasExpiration = newProduct.Pro_date_exp != null;
        previewImage = newProduct.Pro_Image ?? "";
        showModal = true;
    }
    private void CloseAddModal() => showModal = false;

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 2);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            newProduct.Pro_Image = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            previewImage = newProduct.Pro_Image ?? "";
        }
    }
	
    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Pro_Name) || string.IsNullOrWhiteSpace(newProduct.Pro_Mark) || string.IsNullOrWhiteSpace(newProduct.Pro_Type_ID))
        {
            toastService.ShowWarning("الاسم، العلامة، ونوع المنتج حقول إجبارية.", "⚠️ بيانات ناقصة");
            return;
        }

        if (!(newProduct.Pro_BuyPrice <= newProduct.Pro_SalePriceG && newProduct.Pro_SalePriceG <= newProduct.Pro_SalePrice_Min && newProduct.Pro_SalePrice_Min <= newProduct.Pro_SalePrice_Max))
        {
            toastService.ShowWarning("خطأ في التسلسل السعري!", "⚠️ التسلسل السعري");
            return;
        }

        // معالجة الصورة: إذا كانت Base64 (تم رفعها للتو)، احفظها كملف
        string imagePathToSave = newProduct.Pro_Image ?? "";
        if (!string.IsNullOrEmpty(newProduct.Pro_Image) && newProduct.Pro_Image.StartsWith("data:image"))
        {
            imagePathToSave = imageService.SaveImageFromBase64(newProduct.Pro_Image, newProduct.Id);
        }

        using var connection = dbService.CreateConnection();
        var parameters = new
        {
            newProduct.Id, newProduct.Pro_Name, newProduct.Pro_Mark, newProduct.Pro_Propr, newProduct.Pro_Unit, 
            newProduct.Pro_Type_ID, newProduct.Pro_Barcode, newProduct.Pro_Qty, newProduct.Pro_QtyMin, 
            newProduct.Pro_BuyPrice, newProduct.Pro_SalePriceG, newProduct.Pro_SalePrice_Min, newProduct.Pro_SalePrice_Max,
            Pro_date_exp = hasExpiration ? newProduct.Pro_date_exp?.ToString("yyyy-MM-dd") : null,
            Pro_Image = imagePathToSave, // حفظ المسار فقط في قاعدة البيانات
            UpdatedAt = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss")
        };

        if (isEditing)
        {
            string sql = @"UPDATE Products SET Pro_Name=@Pro_Name, Pro_Mark=@Pro_Mark, Pro_Propr=@Pro_Propr, Pro_Unit=@Pro_Unit, Pro_Type_ID=@Pro_Type_ID, 
                            Pro_Barcode=@Pro_Barcode, Pro_Qty=@Pro_Qty, Pro_QtyMin=@Pro_QtyMin, Pro_BuyPrice=@Pro_BuyPrice, Pro_SalePriceG=@Pro_SalePriceG, 
                            Pro_SalePrice_Min=@Pro_SalePrice_Min, Pro_SalePrice_Max=@Pro_SalePrice_Max, Pro_date_exp=@Pro_date_exp, Pro_Image=@Pro_Image, UpdatedAt=@UpdatedAt, IsSynced=0 WHERE Id=@Id";
            await connection.ExecuteAsync(sql, parameters);
        }
        else
        {
            string sql = @"INSERT INTO Products (Id, Pro_Name, Pro_Mark, Pro_Propr, Pro_Unit, Pro_Type_ID, Pro_Barcode, Pro_Qty, Pro_QtyMin, Pro_BuyPrice, Pro_SalePriceG, Pro_SalePrice_Min, Pro_SalePrice_Max, Pro_date_exp, Pro_Image, UpdatedAt, IsSynced, IsDeleted) 
                           VALUES (@Id, @Pro_Name, @Pro_Mark, @Pro_Propr, @Pro_Unit, @Pro_Type_ID, @Pro_Barcode, @Pro_Qty, @Pro_QtyMin, @Pro_BuyPrice, @Pro_SalePriceG, @Pro_SalePrice_Min, @Pro_SalePrice_Max, @Pro_date_exp, @Pro_Image, @UpdatedAt, 0, 0)";
            await connection.ExecuteAsync(sql, parameters);
        }

        CloseAddModal();
        await LoadProductsAsync();
        toastService.ShowSuccess(isEditing ? "تم تعديل المنتج بنجاح" : "تمت إضافة المنتج بنجاح", "📦 المنتجات");
    }

    private async Task DeleteProduct(string id)
    {
        // حماية: الحذف مخصص للمدير فقط (البائع لا يملك أزرار الحذف ولا هذا الكود)
        if (!authService.IsAdmin)
        {
            toastService.ShowWarning("حذف المنتجات متاح للمدير فقط.", "🔒 حذف المنتج");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذا المنتج؟");
        if (!confirmed) return;

        using var connection = dbService.CreateConnection();
        int invoiceCount = connection.ExecuteScalar<int>("SELECT COUNT(*) FROM Order_Details WHERE Pro_ID = @Id", new { Id = id });
        
        if (invoiceCount > 0)
        {
            toastService.ShowWarning("لا يمكن حذف هذا المنتج لأنه مرتبط بفواتير موجودة. يمكنك تعديله بدلاً من حذفه.", "⚠️ حذف المنتج");
            return;
        }

        connection.Execute("UPDATE Products SET IsDeleted=1, IsSynced=0 WHERE Id=@Id", new { Id = id });
        await LoadProductsAsync();
        toastService.ShowSuccess("تم حذف المنتج", "📦 المنتجات");
    }

    private void GenerateBarcodeForProduct()
    {
        newProduct.Pro_Barcode = GenerateBarcodeCode();
        toastService.ShowSuccess("تم توليد الباركود: " + newProduct.Pro_Barcode, "🔧 الباركود");
    }

    // مسح باركود بالكاميرا وملء حقل الباركود (أندرويد فقط)
    private async Task ScanBarcodeForProductAsync()
    {
        if (!BarcodeService.IsAndroid)
        {
            toastService.ShowWarning("المسح بالكاميرا متاح فقط على أندرويد.", "📷 الباركود");
            return;
        }
        try
        {
            var status = await Permissions.RequestAsync<Permissions.Camera>();
            if (status != PermissionStatus.Granted)
            {
                toastService.ShowWarning("لم يتم منح إذن الكاميرا.", "📷 الباركود");
                return;
            }

            var photo = await MediaPicker.Default.CapturePhotoAsync();
            if (photo == null) return; // المستخدم ألغى التصوير

            var code = await BarcodeService.DecodeBarcodeFromPhotoAsync(photo);
            if (string.IsNullOrWhiteSpace(code))
            {
                toastService.ShowWarning("تعذر قراءة الباركود من الصورة. حاول مرة أخرى بإضاءة أفضل.", "📷 الباركود");
                return;
            }

            newProduct.Pro_Barcode = code;
            toastService.ShowSuccess("تم قراءة الباركود: " + code, "📷 الباركود");
        }
        catch (Exception ex)
        {
            toastService.ShowError("خطأ أثناء المسح: " + ex.Message, "❌ الباركود");
        }
    }

    private static string GenerateBarcodeCode()
    {
        return "2" + DateTime.Now.ToString("yyMMddHHmmss");
    }

    private bool showBarcodePreview = false;
    private string previewBarcodeUri = "";
    private string previewBarcodeName = "";
    private string previewBarcodeCode = "";

    private void OpenBarcodePreview()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Pro_Barcode))
            newProduct.Pro_Barcode = GenerateBarcodeCode();

        try
        {
            var opts = barcodeService.LoadOptions();
            var (w, h) = BarcodeService.GetSizePixels(opts.Size, opts.Type);
            previewBarcodeUri = barcodeService.GenerateBarcodeDataUri(newProduct.Pro_Barcode, opts.Type, w, h);
        }
        catch
        {
            previewBarcodeUri = "";
        }
        previewBarcodeName = newProduct.Pro_Name;
        previewBarcodeCode = newProduct.Pro_Barcode;
        showBarcodePreview = true;
    }

    private async Task PrintPreviewBarcode()
    {
        if (string.IsNullOrWhiteSpace(previewBarcodeCode))
        {
            toastService.ShowWarning("لا يوجد باركود للطباعة.", "⚠️ الباركود");
            return;
        }
        try
        {
            await sysPrintService.PrintBarcodeAsync(JS, new BarcodePrintData
            {
                Name = previewBarcodeName,
                Code = previewBarcodeCode,
                Price = newProduct.Pro_SalePrice_Min,
                HigherPrice = newProduct.Pro_SalePrice_Max,
                Quantity = newProduct.Pro_Qty
            });
            showBarcodePreview = false;
        }
        catch (Exception ex)
        {
            toastService.ShowError("تعذر فتح الطباعة: " + ex.Message, "❌ طباعة الباركود");
        }
    }

