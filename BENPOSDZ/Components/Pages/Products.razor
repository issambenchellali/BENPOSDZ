@page "/products"
@using BENPOSDZ.Services
@using Dapper
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@inject DatabaseService dbService
@inject IJSRuntime JS
@inject ImageService imageService
@inject IApplicationStateService appState
@inject ToastService toastService
@inject PrintService sysPrintService
@inject BarcodeService barcodeService

<h2>إدارة المنتجات</h2>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="page-error">
        <strong>⚠️ تعذر تحميل البيانات:</strong> @loadError
        <button class="btn-save" style="width:auto; margin-top:8px;" @onclick="ReloadProducts">إعادة المحاولة</button>
    </div>
}


<div class="top-bar">
    <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="LoadProductsAsync" placeholder="🔍 ابحث بالاسم أو الباركود..." class="search-input"/>
    @if (authService.IsAdmin)
    {
        <button class="btn-print-prod" @onclick="OpenPrintModal">📄 طباعة قائمة الأسعار</button>
    }
	<button class="btn-print-inv" @onclick="PrintSheet">🖨️ طباعة قائمة الجرد</button>
	<button class="btn-apply" @onclick="ApplyInventory">✅ تطبيق الجرد</button>
	<button class="btn-add" @onclick="OpenAddModal">+ إضافة منتج جديد</button>

</div>


@if (lowStockItems.Any())
{
    <div class="alert alert-warning">
        ⚠️ تنبيه: المنتجات التالية على وشك النفاد: 
        <strong>@string.Join("، ", lowStockItems.Select(p => p.Pro_Name))</strong>
    </div>
}

<div class="products-table-wrap">
<table class="products-table responsive-table">
    <thead>
        <tr>
            <th>الصورة</th>
            <th>الاسم</th>
            <th>الباركود</th>
            <th>كمية المخزون</th>
            <th>كمية الجرد</th>
            <th>تم الجرد</th>
            <th>الصلاحية</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in productsList)
        {
            <tr>
                <td data-label="الصورة"><img src="@(string.IsNullOrEmpty(product.Pro_Image) ? "https://via.placeholder.com/40" : product.Pro_Image)" class="product-img" /></td>
                <td data-label="الاسم">@product.Pro_Name (@product.Pro_Mark)</td>
                <td data-label="الباركود">@product.Pro_Barcode</td>
                <td data-label="كمية المخزون" class="@(product.Pro_Qty <= product.Pro_QtyMin && product.Pro_QtyMin > 0 ? "low-stock" : "")">@product.Pro_Qty @product.Pro_Unit</td>
                <td data-label="كمية الجرد"><input type="number" @bind="product.Pro_Qty_Inv" @bind:after="() => SaveInventoryState(product)" class="inv-input" disabled="@(product.Is_Counted == false)" /></td>
				<td data-label="تم الجرد"><input type="checkbox" @bind="product.Is_Counted" @bind:after="() => ToggleCounted(product)" /></td>
				

                <td data-label="الصلاحية">@(string.IsNullOrEmpty(product.Pro_date_exp) ? "-" : product.Pro_date_exp)</td>
                <td data-label="إجراءات">
					@if (authService.IsAdmin)
					{
						<button class="btn-edit" @onclick="() => EditProduct(product)">تعديل</button>
						<button class="btn-delete" @onclick="() => DeleteProduct(product.Id)">حذف</button>
					}
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (showModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h3>@(isEditing ? "تعديل منتج" : "إضافة منتج جديد")</h3>
            
            <div class="form-group">
                <label>صورة المنتج</label>
                <InputFile OnChange="OnImageSelected" accept="image/*" class="file-input" />
                @if (!string.IsNullOrEmpty(previewImage))
                {
                    <img src="@previewImage" class="preview-img" />
                }
            </div>

            <div class="form-group">
                <label>اسم السلعة *</label>
                <input type="text" @bind="newProduct.Pro_Name" placeholder="مثال: قهوة" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>العلامة التجارية</label>
                    <input type="text" @bind="newProduct.Pro_Mark" placeholder="مثال: Nescafé" />
                </div>
                <div class="form-group">
                    <label>الخصائص</label>
                    <input type="text" @bind="newProduct.Pro_Propr" placeholder="مثال: 100غ" />
                </div>
            </div>
            <div class="form-row">
				<div class="form-group">
                    <label>نوع المنتج</label>
                    <select @bind="newProduct.Pro_Type_ID" class="form-control">
                        <option value="">-- اختر النوع --</option>
                        @foreach (var type in productTypes)
                        {
                            <option value="@type.Id">@type.Type_Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>وحدة القياس</label>
                    <input type="text" @bind="newProduct.Pro_Unit" placeholder="مثال: علبة، كيلو" />
                </div>
				<div class="form-group">
                    <label>الباركود</label>
                    <input type="text" @bind="newProduct.Pro_Barcode" placeholder="اتركه فارغاً لتوليد تلقائي" />
                    <div class="barcode-actions">
                        <button type="button" class="btn-gen-code" @onclick="GenerateBarcodeForProduct">🔧 توليد باركود</button>
                        <button type="button" class="btn-print-code" @onclick="OpenBarcodePreview">🖨️ طباعة الباركود</button>
                        @if (BarcodeService.IsAndroid)
                        {
                            <button type="button" class="btn-scan-code" @onclick="ScanBarcodeForProductAsync">📷 مسح بالكاميرا</button>
                        }
                    </div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>الكمية الحالية</label>
                    <input type="number" @bind="newProduct.Pro_Qty" placeholder="0" />
                </div>
                <div class="form-group">
                    <label>حد التنبيه (الحد الأدنى)</label>
                    <input type="number" @bind="newProduct.Pro_QtyMin" placeholder="0 = تعطيل التنبيه" />
                </div>
            </div>
            <div class="form-row">
				@if (authService.IsAdmin)
				{
                <div class="form-group">
                    <label>سعر الشراء (دج)</label>
                    <input type="number" @bind="newProduct.Pro_BuyPrice" placeholder="1000.00" />
                </div>
				}
                <div class="form-group">
                    <label>سعر الجملة (دج)</label>
                    <input type="number" @bind="newProduct.Pro_SalePriceG" placeholder="1200.00" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>سعر التجزئة الأدنى (دج)</label>
                    <input type="number" @bind="newProduct.Pro_SalePrice_Min" placeholder="1300.00" />
                </div>
                <div class="form-group">
                    <label>سعر التجزئة الأعلى (دج)</label>
                    <input type="number" @bind="newProduct.Pro_SalePrice_Max" placeholder="1500.00" />
                </div>
            </div>

            <div class="form-group">
                <label><input type="checkbox" @bind="hasExpiration" /> المنتج يحتوي على تاريخ صلاحية</label>
                @if (hasExpiration)
                {
                    <input type="date" @bind="newProduct.Pro_date_exp" class="mt-2" />
                }
            </div>

            <div class="modal-actions">
                <button class="btn-save" @onclick="SaveProduct">حفظ</button>
                <button class="btn-cancel" @onclick="CloseAddModal">إلغاء</button>
            </div>
        </div>
    </div>
}
@if (showBarcodePreview)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 380px;">
            <h3>🏷️ معاينة الباركود</h3>
            @if (!string.IsNullOrEmpty(previewBarcodeName))
            {
                <div style="font-weight:bold; font-size:15px;">@previewBarcodeName</div>
            }
            <div style="background:#fff; border:1px solid #ddd; border-radius:8px; padding:14px; text-align:center;">
                <img src="@previewBarcodeUri" alt="الباركود" style="max-width:100%; height:auto;" />
                <div style="font-size:13px; direction:ltr; letter-spacing:1px; color:#333; margin-top:4px;">@previewBarcodeCode</div>
            </div>
            <div style="font-size:12px; color:#666; text-align:center;">يُطبع هذا الباركود وفق خيارات تبويب «الباركود» في الإعدادات (النوع، الحجم، عدد النسخ، النصوص).</div>
            <div class="modal-actions">
                <button class="btn-save" @onclick="PrintPreviewBarcode">🖨️ طباعة</button>
                <button class="btn-cancel" @onclick="() => showBarcodePreview = false">إغلاق</button>
            </div>
        </div>
    </div>
}
@if (showPrintModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 450px;">
            <h3>خيارات طباعة قائمة المنتجات</h3>
            <div class="form-group" style="text-align: right;">
                <label><input type="checkbox" @bind="printOnlyAvailable" /> طباعة المنتجات المتوفرة فقط (كمية > 0)</label>
            </div>
            <div class="form-group" style="text-align: right;">
                <label>الأعمدة المطلوب طباعتها:</label>
				<div><label><input type="checkbox" @bind="printColQty" /> إظهار الكمية</label></div>
                <div><label><input type="checkbox" @bind="printColBuy" /> سعر الشراء</label></div>
                <div><label><input type="checkbox" @bind="printColWhole" /> سعر الجملة</label></div>
                <div><label><input type="checkbox" @bind="printColRetailMin" /> تجزئة (أدنى)</label></div>
                <div><label><input type="checkbox" @bind="printColRetailMax" /> تجزئة (أعلى)</label></div>
            </div>
            <div class="modal-actions">
                <button class="btn-save" @onclick="ConfirmPrintProducts">🖨️ طباعة</button>
                <button class="btn-cancel" @onclick="() => showPrintModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

<style>
    .page-error { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 14px 18px; border-radius: 8px; margin-bottom: 15px; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
    .top-bar { display: flex; justify-content: space-between; margin-bottom: 15px; }
    .search-input { width: 300px; padding: 10px; border: 1px solid #ccc; border-radius: 5px; }
    .alert { padding: 15px; background: #fff3cd; border: 1px solid #ffe69c; border-radius: 5px; margin-bottom: 15px; }
    .products-table-wrap { overflow-x: auto; border-radius: 8px; }
    .products-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; }
    .products-table th { background: #007bff; color: white; padding: 12px; text-align: right; }
    .products-table td { padding: 10px; border-bottom: 1px solid #eee; }
    .product-img { width: 40px; height: 40px; border-radius: 5px; object-fit: cover; }
    .preview-img { width: 80px; height: 80px; border-radius: 5px; margin-top: 10px; object-fit: cover; }
    .file-input { margin-bottom: 10px; }
    .low-stock { color: #dc3545; font-weight: bold; }
    .btn-edit { background: #ffc107; color: black; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; }
    .btn-delete { background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; margin-right: 5px;}
    .btn-print { background: #17a2b8; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 12px; margin-right: 5px;}
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 1000;}
    .modal-box { background: white; padding: 25px; border-radius: 10px; width: 650px; max-height: 90vh; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
    .form-row { display: flex; gap: 15px; }
    .form-group { flex: 1; display: flex; flex-direction: column; margin-bottom: 10px; }
    .form-group label { font-weight: bold; margin-bottom: 5px; font-size: 14px; }
    .form-group input { padding: 8px; border: 1px solid #ccc; border-radius: 5px; }
    .modal-actions { display: flex; justify-content: space-between; margin-top: 15px; }
    .btn-save { background: #007bff; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 45%; }
    .btn-cancel { background: #6c757d; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 45%; }
    .btn-add { background: #28a745; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; height: fit-content;}
    .mt-2 { margin-top: 10px; }
	.btn-apply { background: #28a745; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; height: fit-content; }
    .btn-print-inv { background: #17a2b8; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; height: fit-content; }
    .inv-input { width: 80px; padding: 5px; border: 1px solid #ccc; border-radius: 4px; text-align: center; }
    .btn-print-prod { background: #6c757d; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; height: fit-content; }
