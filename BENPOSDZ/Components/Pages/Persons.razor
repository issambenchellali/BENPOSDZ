@page "/persons"
@using BENPOSDZ.Services
@using Dapper
@using System.Text
@using System.Data
@inject DatabaseService dbService
@inject IJSRuntime JS
@inject AuthService authService
@inject PrintTemplateService printService
@inject PrintService sysPrintService
@inject ToastService toastService

<h2>إدارة العملاء والموردين</h2>

<div class="tabs">
    <button class="tab-btn @(currentTab == 1 ? "active" : "")" @onclick="() => SwitchTab(1)">👥 العملاء</button>
    @if (authService.IsAdmin)
    {
        <button class="tab-btn @(currentTab == 2 ? "active" : "")" @onclick="() => SwitchTab(2)">🚚 الموردين</button>
    }
</div>

<div class="debt-summary">
    <span>إجمالي الديون المتراكمة: <strong>@totalDebt.ToString("0.00") د.ج</strong></span>
    <button class="btn-print-debts" @onclick="PrintDebts">🖨️ طباعة قائمة الديون</button>
</div>

<table class="persons-table responsive-table">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الهاتف</th>
            <th>الدين المتراكم</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in personsList)
        {
            <tr>
                <td data-label="الاسم">@p.Person_Name</td>
                <td data-label="الهاتف">@p.Person_Phone</td>
                <td data-label="الدين المتراكم" class="@(p.Person_Debt > 0 ? "debt-color" : "no-debt")">@p.Person_Debt.ToString("0.00") د.ج</td>
                <td data-label="إجراءات">
                    <button class="btn-history" @onclick="() => ViewHistory(p.Id, p.Person_Name)">📜 السجل</button>
                    @if (p.Person_Debt > 0)
                    {
                        <button class="btn-pay" @onclick="() => OpenPayModal(p)">💵 تسديد الدين</button>
                    }
                    <button class="btn-edit-person" @onclick="() => OpenEditPersonModal(p)">✏️ تعديل</button>
                    <button class="btn-delete-person" @onclick="() => DeletePerson(p)">🗑️</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (showHistoryModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 860px; max-width: 96vw;">
            <h3>📜 سجل معاملات: @historyName</h3>
            <div class="history-toolbar">
                <div class="date-filters">
                    <label>من</label>
                    <input type="date" @bind="filterFrom" />
                    <label>إلى</label>
                    <input type="date" @bind="filterTo" />
                </div>
                <div class="history-actions">
                    <label class="details-chk">
                        <input type="checkbox" @bind="printInvoiceDetails" /> طباعة تفاصيل الفواتير
                    </label>
                    <button class="btn-print-statement" @onclick="PrintFinancialStatement">🖨️ طباعة الوصل المالي</button>
                </div>
            </div>
            <div class="history-wrap">
                <table class="history-table responsive-table">
                    <thead>
                        <tr><th>التاريخ</th><th>النوع</th><th>المبلغ</th><th>المدفوع</th><th>الدين</th><th>دفع مبلغ</th><th>طباعة</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in FilteredInvoices)
                        {
                            <tr>
                                <td data-label="التاريخ">@inv.Order_Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td data-label="النوع">@GetTypeName(inv.Order_Type)</td>
                                <td data-label="المبلغ">@inv.Price.ToString("0.00") د.ج</td>
                                <td data-label="المدفوع">@inv.Paid.ToString("0.00") د.ج</td>
                                <td data-label="الدين" class="@(inv.Unpaid > 0 ? "debt-color" : "")">@inv.Unpaid.ToString("0.00") د.ج</td>
                                <td data-label="دفع مبلغ">
                                    @if (inv.Unpaid > 0)
                                    {
                                        <button class="btn-partial" @onclick="() => OpenPartialPay(inv)">💰 دفع مبلغ</button>
                                    }
                                </td>
                                <td data-label="طباعة"><button class="btn-print-sm" @onclick="() => PrintInvoice(inv.Id)">🖨️</button></td>
                            </tr>
                        }
                        @if (!FilteredInvoices.Any())
                        {
                            <tr><td colspan="7" class="fin-empty">لا توجد عمليات في هذه الفترة.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn-cancel" @onclick="() => showHistoryModal = false" style="width:100%; margin-top:15px;">إغلاق</button>
        </div>
    </div>
}

@if (showPayModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 450px;">
            <h3>تسديد دين</h3>
            <p>الدين الحالي لـ <strong>@selectedPerson?.Person_Name</strong>: @selectedPerson?.Person_Debt.ToString("0.00") د.ج</p>
            <div class="form-group">
                <label>المبلغ المدفوع</label>
                <input type="number" @bind="paymentAmount" min="0" max="@selectedPerson?.Person_Debt" />
            </div>
            <p class="hint">@((selectedPerson?.Person_Type == 1 ? "سيتم إضافة المبلغ للصندوق (Caisse)" : "سيتم خصم المبلغ من الخزنة (Coffer)"))</p>
            <div class="modal-actions">
                <button class="btn-save" @onclick="ConfirmPayment">تأكيد التسديد</button>
                <button class="btn-cancel" @onclick="() => showPayModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

@if (showPartialPayModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 430px;">
            <h3>💰 دفع مبلغ من الفاتورة</h3>
            <p>رقم الفاتورة: <strong>@(partialPayInvoice != null ? ShortId(partialPayInvoice.Id) : "-")</strong></p>
            <p>الدين المتبقي على هذه الفاتورة: <strong>@partialPayInvoice?.Unpaid.ToString("0.00") د.ج</strong></p>
            <div class="form-group">
                <label>المبلغ المدفوع</label>
                <input type="number" @bind="partialPayAmount" min="0" max="@partialPayInvoice?.Unpaid" />
            </div>
            <p class="hint">لا يمكن دفع أكثر من الدين المتبقي للفاتورة.</p>
            <div class="modal-actions">
                <button class="btn-save" @onclick="ConfirmPartialPay">تأكيد الدفع</button>
                <button class="btn-cancel" @onclick="() => showPartialPayModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

@if (showEditPersonModal)
{
    <div class="modal-overlay">
        <div class="modal-box" style="width: 520px;">
            <h3>✏️ تعديل بيانات: @editingPerson.Person_Name</h3>
            <div class="form-group" style="text-align:right;">
                <label>الاسم</label>
                <input type="text" @bind="editingPerson.Person_Name" placeholder="اسم الشخص" />
            </div>
            <div class="form-group" style="text-align:right;">
                <label>الهاتف</label>
                <input type="text" @bind="editingPerson.Person_Phone" placeholder="رقم الهاتف" />
            </div>
            <div class="form-group" style="text-align:right;">
                <label>العنوان</label>
                <input type="text" @bind="editingPerson.Person_Adress" placeholder="العنوان" />
            </div>
            <div class="form-group" style="text-align:right;">
                <label>ملاحظات</label>
                <input type="text" @bind="editingPerson.Person_Notes" placeholder="ملاحظات إضافية" />
            </div>
            <div class="form-group" style="text-align:right;">
                <label>رقم السجل التجاري (RC)</label>
                <input type="text" @bind="editingPerson.Person_NRC" placeholder="RC" />
            </div>
            <div class="form-group" style="text-align:right;">
                <label>رقم الضريبة على الأنشطة (NIF)</label>
                <input type="text" @bind="editingPerson.Person_NIF" placeholder="NIF" />
            </div>
            <div class="form-group" style="text-align:right;">
                <label>رقم الضمان الاجتماعي (NIS)</label>
                <input type="text" @bind="editingPerson.Person_NIS" placeholder="NIS" />
            </div>
            <div class="modal-actions">
                <button class="btn-save" @onclick="SavePersonEdit">حفظ التعديل</button>
                <button class="btn-cancel" @onclick="() => showEditPersonModal = false">إلغاء</button>
            </div>
        </div>
    </div>
}

<style>
    .tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #eee; }
    .tab-btn { padding: 10px 20px; border: none; background: none; cursor: pointer; font-size: 16px; font-weight: bold; color: #666; border-bottom: 3px solid transparent; }
    .tab-btn.active { color: #007bff; border-bottom: 3px solid #007bff; }
    .persons-table { width: 100%; background: white; border-radius: 8px; overflow: hidden; border-collapse: collapse; }
    .persons-table th { background: #007bff; color: white; padding: 12px; text-align: right; }
    .persons-table td { padding: 12px; border-bottom: 1px solid #eee; }
    .debt-color { color: #dc3545; font-weight: bold; }
    .no-debt { color: #28a745; }
    .btn-history { background: #6c757d; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; }
    .btn-pay { background: #28a745; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; margin-right: 5px; }
    .btn-edit-person { background: #007bff; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; margin-right: 5px; }
    .btn-delete-person { background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; margin-right: 5px; }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 1000;}
    .modal-box { background: white; padding: 25px; border-radius: 10px; display: flex; flex-direction: column; gap: 10px; text-align: center;}
    .history-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 10px 12px; }
    .date-filters { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .date-filters label { font-size: 12px; color: #555; font-weight: bold; }
    .date-filters input { padding: 6px; border: 1px solid #ccc; border-radius: 5px; font-size: 13px; }
    .history-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .details-chk { display: flex; align-items: center; gap: 5px; font-size: 13px; color: #333; }
    .details-chk input { width: 18px; height: 18px; }
    .btn-print-statement { background: #17a2b8; color: white; border: none; padding: 8px 14px; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 13px; }
    .history-wrap { overflow-x: auto; }
    .history-table { width: 100%; border-collapse: collapse; margin-top: 10px; min-width: 640px; }
    .history-table th { background: #f8f9fa; padding: 8px; text-align: right; border: 1px solid #ddd; white-space: nowrap; }
    .history-table td { padding: 8px; border: 1px solid #ddd; white-space: nowrap; }
    .btn-partial { background: #fd7e14; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold; }
    .btn-print-sm { background: #17a2b8; color: white; border: none; padding: 3px 6px; border-radius: 3px; cursor: pointer; }
    .fin-empty { color: #999; padding: 16px; }
    .form-group { text-align: right; margin: 15px 0; }
    .form-group label { display: block; font-weight: bold; margin-bottom: 5px; }
    .form-group input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; font-size: 18px; }
    .hint { color: #dc3545; font-size: 13px; }
    .modal-actions { display: flex; justify-content: space-between; margin-top: 20px; }
    .btn-save { background: #28a745; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 45%; }
    .btn-cancel { background: #6c757d; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 45%; }
    .debt-summary { display: flex; justify-content: space-between; align-items: center; background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 12px 18px; margin-bottom: 15px; font-size: 17px; flex-wrap: wrap; gap: 8px; }
    .debt-summary strong { color: #dc3545; }
    .btn-print-debts { background: #17a2b8; color: white; border: none; padding: 8px 16px; border-radius: 5px; cursor: pointer; font-size: 14px; }
</style>

@code {
    [Inject] NavigationManager Nav { get; set; } = null!;
    protected override void OnInitialized()
    {
        MigrateDebtModel();
		if (!authService.IsAdmin) { currentTab = 1; LoadPersons(); return; }
        LoadPersons();
    }

    private int currentTab = 1; // 1=عملاء، 2=mوردين
    private List<PersonModel> personsList = new();
    private decimal totalDebt = 0;

    private void MigrateDebtModel()
    {
        try
        {
            using var localConn = dbService.CreateLocalConnection();
            var migrated = localConn.QueryFirstOrDefault<string>("SELECT `Value` FROM AppSettings WHERE `Key` = 'DebtBaseMigrated'");
            if (migrated == "1") return;

            using var connection = dbService.CreateConnection();
            connection.Execute("UPDATE Persons SET Person_Debt = 0");
            localConn.Execute("INSERT OR REPLACE INTO AppSettings (`Key`, `Value`) VALUES ('DebtBaseMigrated', '1')");
            dbService.LogEvent("🧾 تم ترحيل نموذج الديون: أصبح Person_Debt ديناً أساسياً فقط.");
        }
        catch { }
    }

    private bool showHistoryModal = false;
    private string historyName = "";
    private string historyPersonId = "";
    private List<InvoiceModel> personInvoices = new();
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private bool printInvoiceDetails = false;

    private bool showPayModal = false;
    private PersonModel? selectedPerson;
    private decimal paymentAmount = 0;

    private bool showPartialPayModal = false;
    private InvoiceModel? partialPayInvoice;
    private decimal partialPayAmount = 0;

    private bool showEditPersonModal = false;
    private PersonModel editingPerson = new();

    private IEnumerable<InvoiceModel> FilteredInvoices => personInvoices.Where(inv =>
        (filterFrom == null || inv.Order_Date.Date >= filterFrom.Value.Date) &&
        (filterTo == null || inv.Order_Date.Date <= filterTo.Value.Date));

    private static string ShortId(string id) => id.Length >= 8 ? id.Substring(0, 8) : id;

    private void SwitchTab(int tab)
    {
        currentTab = tab;
        LoadPersons();
    }

    private void LoadPersons()
    {
        using var connection = dbService.CreateConnection();
        personsList = connection.Query<PersonModel>(@"
            SELECT p.Id, p.Person_Name, p.Person_Phone, p.Person_Type,
                   p.Person_Debt + COALESCE((SELECT SUM(o.Unpaid) FROM Orders o WHERE o.Person_ID = p.Id AND o.IsDeleted = 0 AND o.Unpaid > 0 AND o.Order_Type IN (0,1,2)), 0) AS Person_Debt
            FROM Persons p
            WHERE p.Person_Type = @Type AND p.IsDeleted = 0 AND p.Person_Name != 'Au Comptoir'
            ORDER BY p.Person_Name", new { Type = currentTab }).ToList();
        totalDebt = personsList.Sum(p => p.Person_Debt);
    }

    private async Task PrintDebts()
    {
        using var connection = dbService.CreateConnection();
        var data = (await connection.QueryAsync<dynamic>(@"
            SELECT p.Person_Name, p.Person_Phone,
                   p.Person_Debt + COALESCE((SELECT SUM(o.Unpaid) FROM Orders o WHERE o.Person_ID = p.Id AND o.IsDeleted = 0 AND o.Unpaid > 0 AND o.Order_Type IN (0,1,2)), 0) AS Debt
            FROM Persons p
            WHERE p.Person_Type = 1 AND p.IsDeleted = 0 AND p.Person_Name != 'Au Comptoir'
              AND (p.Person_Debt > 0 OR EXISTS (SELECT 1 FROM Orders o WHERE o.Person_ID = p.Id AND o.Unpaid > 0 AND o.IsDeleted = 0 AND o.Order_Type IN (0,1,2)))
            ORDER BY p.Person_Name")).ToList();

        if (data.Count == 0)
        {
            toastService.ShowWarning("لا توجد ديون لطباعتها", "ℹ️ طباعة الديون");
            return;
        }

        var sb = new StringBuilder();
        sb.AppendLine("<!DOCTYPE html><html dir='rtl' lang='ar'><head><meta charset='utf-8'/><title>قائمة الديون</title><style>body{font-family:Arial,sans-serif;padding:15mm;direction:rtl;}h2{text-align:center;margin:0 0 5px;}p.date{text-align:center;color:#555;margin-top:0;}table{width:100%;border-collapse:collapse;margin-top:15px;}th,td{border:1px solid #000;padding:8px;text-align:right;}th{background:#eee;}tfoot td{font-weight:bold;}</style></head><body>");
        sb.AppendLine("<h2>قائمة ديون العملاء</h2>");
        sb.AppendLine($"<p class='date'>التاريخ: {DateTime.Now:yyyy-MM-dd HH:mm}</p>");
        sb.AppendLine("<table><thead><tr><th>الاسم</th><th>الهاتف</th><th>الدين (د.ج)</th><th>التوقيع</th></tr></thead><tbody>");
        decimal total = 0;
        foreach (dynamic d in data)
        {
            decimal debt = (decimal)d.Debt;
            total += debt;
            sb.AppendLine($"<tr><td>{d.Person_Name}</td><td>{d.Person_Phone}</td><td>{debt:0.00}</td><td></td></tr>");
        }
        sb.AppendLine("</tbody><tfoot><tr><td colspan='2'>الإجمالي</td><td>" + total.ToString("0.00") + "</td><td></td></tr></tfoot></table>");
        sb.AppendLine("</body></html>");

        await sysPrintService.PrintHtmlAsync(JS, sb.ToString(), false);
    }

    private async Task ViewHistory(string id, string name)
    {
        historyPersonId = id;
        historyName = name;
        using var connection = dbService.CreateConnection();
        string sql = "SELECT * FROM Orders WHERE Person_ID = @Id AND IsDeleted = 0 ORDER BY Order_Date DESC";
        personInvoices = (await connection.QueryAsync<InvoiceModel>(sql, new { Id = id })).ToList();
        showHistoryModal = true;
    }

    // تسجيل حركة مالية في Historique (سجل حركات الزبون)
    private async Task LogHistoryAsync(IDbConnection conn, IDbTransaction? tx, string personId, string type, decimal amount, string? invoiceId, string notes)
    {
        string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
        await conn.ExecuteAsync(@"INSERT INTO Historique (Id, Person_ID, Hist_Date, Hist_Type, Hist_Amount, Invoice_ID, Hist_Notes, UpdatedAt, IsSynced, IsDeleted)
                                  VALUES (@Id, @PersonId, @Date, @Type, @Amount, @InvoiceId, @Notes, @Date, 0, 0)",
            new { Id = Guid.NewGuid().ToString(), PersonId = personId, Date = dateNow, Type = type, Amount = amount, InvoiceId = invoiceId, Notes = notes }, tx);
    }

    private void OpenPayModal(PersonModel p)
    {
        selectedPerson = p;
        paymentAmount = p.Person_Debt; // افتراضياً دفع الكل
        showPayModal = true;
    }

    // فتح نافذة تعديل بيانات الشخص (نسخة قابلة للتعديل حتى لا تتأثر القائمة أثناء الإدخال)
    private void OpenEditPersonModal(PersonModel p)
    {
        editingPerson = new PersonModel
        {
            Id = p.Id,
            Person_Name = p.Person_Name,
            Person_Phone = p.Person_Phone,
            Person_Type = p.Person_Type,
            Person_Adress = p.Person_Adress,
            Person_Notes = p.Person_Notes,
            Person_NRC = p.Person_NRC,
            Person_NIF = p.Person_NIF,
            Person_NIS = p.Person_NIS,
            Person_Debt = p.Person_Debt
        };
        showEditPersonModal = true;
    }

    private async Task SavePersonEdit()
    {
        if (!showEditPersonModal || string.IsNullOrEmpty(editingPerson.Id)) return;
        if (string.IsNullOrWhiteSpace(editingPerson.Person_Name))
        {
            toastService.ShowWarning("اسم الشخص مطلوب!", "⚠️ التعديل");
            return;
        }
        try
        {
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
            using var connection = dbService.CreateConnection();
            await connection.ExecuteAsync(@"UPDATE Persons SET
                        Person_Name = @Name, Person_Phone = @Phone, Person_Adress = @Adress, Person_Notes = @Notes,
                        Person_NRC = @NRC, Person_NIF = @NIF, Person_NIS = @NIS, UpdatedAt = @Date, IsSynced = 0
                    WHERE Id = @Id",
                new { Id = editingPerson.Id, Name = editingPerson.Person_Name, Phone = editingPerson.Person_Phone,
                      Adress = editingPerson.Person_Adress, Notes = editingPerson.Person_Notes, NRC = editingPerson.Person_NRC,
                      NIF = editingPerson.Person_NIF, NIS = editingPerson.Person_NIS, Date = dateNow });
            dbService.LogEvent($"✏️ تم تعديل بيانات الشخص: {editingPerson.Person_Name}");
            showEditPersonModal = false;
            LoadPersons();
            toastService.ShowSuccessShort("تم حفظ التعديل بنجاح", "✅ التعديل");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل حفظ التعديل: " + ex.Message, "❌ التعديل");
        }
    }

    // حذف آمن للشخص: يُمنع إن كان لديه ديون غير مسددة (حماية الحسابات المالية)
    private async Task DeletePerson(PersonModel p)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"هل أنت متأكد من حذف «{p.Person_Name}»؟");
        if (!confirmed) return;

        using var connection = dbService.CreateConnection();
        decimal unpaidDebt = connection.ExecuteScalar<decimal>("SELECT COALESCE(SUM(Unpaid), 0) FROM Orders WHERE Person_ID = @Id AND IsDeleted = 0 AND Unpaid > 0 AND Order_Type IN (0,1,2)", new { Id = p.Id });
        if (p.Person_Debt > 0.01m || unpaidDebt > 0.01m)
        {
            toastService.ShowWarning("لا يمكن حذف هذا الشخص لأن لديه ديوناً غير مسددة. سدّد الدين أولاً.", "⚠️ الحذف");
            return;
        }
        int invoiceCount = connection.ExecuteScalar<int>("SELECT COUNT(*) FROM Orders WHERE Person_ID = @Id AND IsDeleted = 0", new { Id = p.Id });
        if (invoiceCount > 0)
        {
            toastService.ShowWarning("لا يمكن حذف هذا الشخص لأنه مرتبط بفواتير محفوظة. يمكنك تعديل بياناته بدلاً من الحذف.", "⚠️ الحذف");
            return;
        }

        try
        {
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
            using var conn = dbService.CreateConnection();
            conn.Execute("UPDATE Persons SET IsDeleted = 1, IsSynced = 0 WHERE Id = @Id", new { Id = p.Id });
            await LogHistoryAsync(conn, null, p.Id, "حذف شخص", 0, null, "تم حذف الشخص من النظام");
            dbService.LogEvent($"🗑️ تم حذف الشخص: {p.Person_Name}");
            LoadPersons();
            toastService.ShowSuccessShort("تم حذف الشخص", "✅ العملاء والموردون");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل الحذف: " + ex.Message, "❌ الحذف");
        }
    }

    private async Task ConfirmPayment()
    {
        if (selectedPerson == null || paymentAmount <= 0 || paymentAmount > selectedPerson.Person_Debt) return;

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");

            // فحص منطقي: مورد → الخزنة يجب أن تغطي مبلغ التسديد
            if (selectedPerson.Person_Type == 2)
            {
                decimal cofferBalance = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(Amount, 0) FROM Coffer LIMIT 1", transaction);
                if (paymentAmount > cofferBalance)
                {
                    transaction.Rollback();
                    toastService.ShowWarning("رصيد الخزنة (Coffer) غير كافٍ لتسديد هذا المبلغ!", "⚠️ الدفع");
                    return;
                }
            }

            // 1. توزيع المبلغ على الفواتير غير المدفوعة (أقدم فاتورة أولاً)
            var unpaidInvoices = (await connection.QueryAsync<InvoiceModel>("SELECT * FROM Orders WHERE Person_ID = @Id AND Unpaid > 0 AND IsDeleted = 0 AND Order_Type IN (0,1,2) ORDER BY Order_Date ASC", new { Id = selectedPerson.Id }, transaction)).ToList();
            decimal remainingPayment = paymentAmount;

            foreach (var inv in unpaidInvoices)
            {
                if (remainingPayment <= 0) break;
                decimal amountToPay = Math.Min(remainingPayment, inv.Unpaid);
                await connection.ExecuteAsync("UPDATE Orders SET Paid = Paid + @Pay, Unpaid = Unpaid - @Pay, UpdatedAt = @Date WHERE Id = @Id", new { Pay = amountToPay, Id = inv.Id, Date = dateNow }, transaction);
                await LogHistoryAsync(connection, transaction, selectedPerson.Id, "تسديد دين", amountToPay, inv.Id, $"تسديد @{amountToPay:0.00} على الفاتورة {ShortId(inv.Id)}");
                remainingPayment -= amountToPay;
            }

            // 2. المبلغ المتبقي يخصم من الدين الأساسي
            if (remainingPayment > 0)
            {
                await connection.ExecuteAsync("UPDATE Persons SET Person_Debt = CASE WHEN Person_Debt >= @Amt THEN Person_Debt - @Amt ELSE 0 END WHERE Id = @Id", new { Amt = remainingPayment, Id = selectedPerson.Id }, transaction);
                await LogHistoryAsync(connection, transaction, selectedPerson.Id, "تسديد دين", remainingPayment, null, "تسديد من الدين الأساسي");
            }

            // 3. إضافة المال للصندوق (إذا كان عميلاً) أو خصمه من الخزنة (إذا كان موردًا)
            if (selectedPerson.Person_Type == 1) // عميل
            {
                await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount + @Amt", new { Amt = paymentAmount }, transaction);
            }
            else // مورد
            {
                await connection.ExecuteAsync("UPDATE Coffer SET Amount = Amount - @Amt", new { Amt = paymentAmount }, transaction);
            }

            transaction.Commit();
            toastService.ShowSuccessShort("تم تسديد الدين بنجاح وتحديث الفواتير!", "✅ الدفع");
            showPayModal = false;
            LoadPersons();
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ: " + ex.Message, "❌ الدفع");
        }
    }

    // فتح نافذة دفع مبلغ من فاتورة محددة (دفعة جزئية)
    private void OpenPartialPay(InvoiceModel inv)
    {
        partialPayInvoice = inv;
        partialPayAmount = inv.Unpaid;
        showPartialPayModal = true;
    }

    private async Task ConfirmPartialPay()
    {
        if (partialPayInvoice == null || partialPayAmount <= 0 || partialPayAmount > partialPayInvoice.Unpaid)
        {
            toastService.ShowWarning("المبلغ المدفوع أكبر من الدين المتبقي للفاتورة!", "⚠️ الدفع");
            return;
        }

        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction();
        try
        {
            string dateNow = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");

            // 1. خصم المبلغ من دين الفاتورة
            await connection.ExecuteAsync("UPDATE Orders SET Paid = Paid + @Pay, Unpaid = Unpaid - @Pay, UpdatedAt = @Date WHERE Id = @Id AND IsDeleted = 0",
                new { Pay = partialPayAmount, Id = partialPayInvoice.Id, Date = dateNow }, transaction);

            // 2. المال: عميل → صندوق، مورد → خزنة
            int personType = await connection.ExecuteScalarAsync<int>("SELECT COALESCE(Person_Type, 1) FROM Persons WHERE Id = @Id", new { Id = historyPersonId }, transaction);
            if (personType == 2)
            {
                decimal cofferBalance = await connection.ExecuteScalarAsync<decimal>("SELECT COALESCE(Amount, 0) FROM Coffer LIMIT 1", transaction);
                if (partialPayAmount > cofferBalance)
                {
                    transaction.Rollback();
                    toastService.ShowWarning("رصيد الخزنة (Coffer) غير كافٍ لدفع هذا المبلغ!", "⚠️ الدفع");
                    return;
                }
                await connection.ExecuteAsync("UPDATE Coffer SET Amount = Amount - @Amt, UpdatedAt = @Date", new { Amt = partialPayAmount, Date = dateNow }, transaction);
            }
            else
            {
                await connection.ExecuteAsync("UPDATE Caisse SET Amount = Amount + @Amt, UpdatedAt = @Date", new { Amt = partialPayAmount, Date = dateNow }, transaction);
            }

            // 3. تسجيل العملية في Historique
            await LogHistoryAsync(connection, transaction, historyPersonId, "دفعة جزئية", partialPayAmount, partialPayInvoice.Id,
                $"دفع مبلغ {partialPayAmount:0.00} على الفاتورة {ShortId(partialPayInvoice.Id)}");

            transaction.Commit();
            toastService.ShowSuccessShort("تم تسجيل الدفعة الجزئية بنجاح", "✅ الدفع");
            showPartialPayModal = false;
            LoadPersons();
            await ViewHistory(historyPersonId, historyName);
        }
        catch (Exception ex)
        {
            transaction.Rollback();
            toastService.ShowError("خطأ: " + ex.Message, "❌ الدفع");
        }
    }

    // طباعة الوصل المالي الكامل: جميع عمليات الزبون (فواتير، مدفوعات، مرتجعات) مع إمكانية طباعة رؤوس الفواتير
    private async Task PrintFinancialStatement()
    {
        if (string.IsNullOrEmpty(historyPersonId)) return;
        try
        {
            using var connection = dbService.CreateConnection();
            var invoices = (await connection.QueryAsync<InvoiceModel>("SELECT * FROM Orders WHERE Person_ID = @Id AND IsDeleted = 0 ORDER BY Order_Date ASC", new { Id = historyPersonId })).ToList();
            var payments = (await connection.QueryAsync<HistoriqueModel>("SELECT * FROM Historique WHERE Person_ID = @Id AND IsDeleted = 0 ORDER BY Hist_Date ASC", new { Id = historyPersonId })).ToList();

            // تصفية حسب التواريخ المختارة
            if (filterFrom != null)
            {
                invoices = invoices.Where(i => i.Order_Date.Date >= filterFrom.Value.Date).ToList();
                payments = payments.Where(p => p.Hist_Date.Date >= filterFrom.Value.Date).ToList();
            }
            if (filterTo != null)
            {
                invoices = invoices.Where(i => i.Order_Date.Date <= filterTo.Value.Date).ToList();
                payments = payments.Where(p => p.Hist_Date.Date <= filterTo.Value.Date).ToList();
            }

            var sb = new StringBuilder();
            sb.AppendLine("<!DOCTYPE html><html dir='rtl' lang='ar'><head><meta charset='utf-8'/><title>وصل مالي</title><style>body{font-family:Arial,sans-serif;padding:15mm;direction:rtl;}h2{text-align:center;margin:0 0 4px;}p.center{text-align:center;color:#555;margin:2px 0;}h3{margin:18px 0 4px;}table{width:100%;border-collapse:collapse;margin-top:8px;}th,td{border:1px solid #000;padding:6px;text-align:right;font-size:12px;}th{background:#eee;}tfoot td{font-weight:bold;background:#f8f8f8;}</style></head><body>");

            string period = (filterFrom != null ? filterFrom.Value.ToString("yyyy-MM-dd") : "البداية") + " ← " + (filterTo != null ? filterTo.Value.ToString("yyyy-MM-dd") : "الآن");
            sb.AppendLine("<h2>وصل مالي — " + System.Net.WebUtility.HtmlEncode(historyName) + "</h2>");
            sb.AppendLine($"<p class='center'>الفترة: {period} | تاريخ الطباعة: {DateTime.Now:yyyy-MM-dd HH:mm}</p>");

            sb.AppendLine("<h3>📄 العمليات والفواتير</h3>");
            sb.AppendLine("<table><thead><tr><th>التاريخ</th><th>رقم الفاتورة</th><th>النوع</th><th>المبلغ</th><th>المدفوع</th><th>الدين</th></tr></thead><tbody>");
            decimal totalSales = 0, totalPaid = 0, totalDebt = 0;
            foreach (var inv in invoices)
            {
                sb.AppendLine($"<tr><td>{inv.Order_Date:yyyy-MM-dd HH:mm}</td><td>{ShortId(inv.Id)}</td><td>{GetTypeName(inv.Order_Type)}</td><td>{inv.Price:0.00}</td><td>{inv.Paid:0.00}</td><td>{inv.Unpaid:0.00}</td></tr>");
                totalSales += inv.Price; totalPaid += inv.Paid; totalDebt += inv.Unpaid;
            }
            sb.AppendLine($"</tbody><tfoot><tr><td colspan='3'>الإجمالي</td><td>{totalSales:0.00}</td><td>{totalPaid:0.00}</td><td>{totalDebt:0.00}</td></tr></tfoot></table>");

            // رؤوس الفواتير (تفاصيل الفاتورة)
            if (printInvoiceDetails && invoices.Any())
            {
                sb.AppendLine("<h3>📋 رؤوس الفواتير (ملخص الفواتير)</h3>");
                foreach (var inv in invoices)
                {
                    var details = (await connection.QueryAsync<dynamic>("SELECT p.Pro_Name, od.Pro_Qty, od.Pro_Price FROM Order_Details od JOIN Products p ON od.Pro_ID = p.Id WHERE od.Order_ID = @Id AND od.IsDeleted = 0", new { Id = inv.Id })).ToList();
                    sb.AppendLine($"<table style='margin-top:10px;'><thead><tr><th colspan='4'>فاتورة {ShortId(inv.Id)} — {inv.Order_Date:yyyy-MM-dd HH:mm} ({GetTypeName(inv.Order_Type)})</th></tr><tr><th>السلعة</th><th>الكمية</th><th>السعر</th><th>المجموع</th></tr></thead><tbody>");
                    foreach (dynamic d in details)
                        sb.AppendLine($"<tr><td>{System.Net.WebUtility.HtmlEncode((string)d.Pro_Name)}</td><td>{(decimal)d.Pro_Qty:0.##}</td><td>{(decimal)d.Pro_Price:0.00}</td><td>{(decimal)(d.Pro_Qty * d.Pro_Price):0.00}</td></tr>");
                    sb.AppendLine("</tbody></table>");
                }
            }

            // المدفوعات المسجلة في Historique
            if (payments.Any())
            {
                sb.AppendLine("<h3>💵 المدفوعات المسجلة</h3>");
                sb.AppendLine("<table><thead><tr><th>التاريخ</th><th>النوع</th><th>المبلغ</th><th>رقم الفاتورة</th><th>ملاحظات</th></tr></thead><tbody>");
                decimal totalPay = 0;
                foreach (var p in payments)
                {
                    string num = !string.IsNullOrEmpty(p.Invoice_ID) ? ShortId(p.Invoice_ID) : "-";
                    sb.AppendLine($"<tr><td>{p.Hist_Date:yyyy-MM-dd HH:mm}</td><td>{p.Hist_Type}</td><td>{p.Hist_Amount:0.00}</td><td>{num}</td><td>{System.Net.WebUtility.HtmlEncode(p.Hist_Notes ?? "")}</td></tr>");
                    totalPay += p.Hist_Amount;
                }
                sb.AppendLine($"</tbody><tfoot><tr><td colspan='2'>الإجمالي</td><td>{totalPay:0.00}</td><td colspan='2'></td></tr></tfoot></table>");
            }

            sb.AppendLine("<p style='margin-top:24px;'>التوقيع: .....................................................</p>");
            sb.AppendLine("</body></html>");

            await sysPrintService.PrintHtmlAsync(JS, sb.ToString(), false);
        }
        catch (Exception ex)
        {
            toastService.ShowError("خطأ في طباعة الوصل: " + ex.Message, "❌ الطباعة");
        }
    }

    private async Task PrintInvoice(string invId)
    {
        // طباعة عبر قالب قابلة للتخصيص من الإعدادات
        using var connection = dbService.CreateConnection();
        var inv = await connection.QueryFirstOrDefaultAsync<dynamic>("SELECT o.*, p.Person_Name FROM Orders o LEFT JOIN Persons p ON o.Person_ID = p.Id WHERE o.Id = @Id", new { Id = invId });
        if (inv == null) return;

        var details = await connection.QueryAsync<dynamic>(@"SELECT p.Pro_Name, od.Pro_Qty, od.Pro_Price FROM Order_Details od JOIN Products p ON od.Pro_ID = p.Id WHERE od.Order_ID = @Id", new { Id = invId });

        var data = new PrintTemplateService.PrintData
        {
            DocType = "invoice",
            Title = "فاتورة",
            InvoiceNumber = invId.Substring(0, 8),
            Date = Convert.ToDateTime(inv.Order_Date).ToString("yyyy-MM-dd HH:mm"),
            Customer = (string)(inv.Person_Name ?? "Au Comptoir"),
            Cashier = authService.CurrentUser?.User_FullName ?? authService.CurrentUser?.User_Name ?? "",
            Items = details.Select(d => new PrintTemplateService.PrintItem((string)d.Pro_Name, (decimal)d.Pro_Qty, (decimal)d.Pro_Price, (decimal)(d.Pro_Qty * d.Pro_Price))).ToList(),
            Total = (decimal)inv.Price, Paid = (decimal)inv.Paid, Debt = (decimal)inv.Unpaid
        };
        string html = printService.RenderFullDocument("invoice", data);
        await sysPrintService.PrintHtmlAsync(JS, html, false);
    }

    private string GetTypeName(int type) => type switch { 0 or 1 => "بيع", 2 => "شراء", 3 => "مرتجع بيع", 4 => "مرتجع شراء", _ => "-" };

