    private void LoadUpdateSettings()
    {
        currentAppVersion = updateService.CurrentVersionString;
        updateRepoUrl = updateService.RepoUrl;
        updateCheckOnStart = updateService.CheckOnStart;
        updateCheckPeriodic = updateService.CheckPeriodic;
        updateAutoDownload = updateService.AutoDownload;
        var last = updateService.LastUpdateCheckUtc;
        updateLastCheck = last > DateTime.MinValue ? last.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : null;
    }

    private void SaveUpdateSettings()
    {
        try
        {
            using var conn = dbService.CreateLocalConnection();
            void Set(string key, string value) =>
                conn.Execute("UPDATE AppSettings SET `Value` = @V WHERE `Key` = @K; INSERT INTO AppSettings (`Key`,`Value`) SELECT @K, @V WHERE (SELECT COUNT(*) FROM AppSettings WHERE `Key` = @K) = 0",
                    new { V = value, K = key });
            Set(UpdateService.K_UpdateRepoUrl, updateRepoUrl?.Trim() ?? "");
            Set(UpdateService.K_UpdateCheckOnStart, updateCheckOnStart ? "true" : "false");
            Set(UpdateService.K_UpdateCheckPeriodic, updateCheckPeriodic ? "true" : "false");
            Set(UpdateService.K_UpdateAutoDownload, updateAutoDownload ? "true" : "false");
            toastService.ShowSuccess("تم حفظ إعدادات التحديث", "💾 التحديثات");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل الحفظ: " + ex.Message, "❌ التحديثات");
        }
    }

    private async Task StartUpdateDownload()
    {
        if (updateService.PendingUpdate == null) return;
        downloadInProgress = true;
        downloadStatus = "جارٍ تنزيل حزمة التحديث...";
        try
        {
            var progress = new Progress<(long Done, long Total)>(p =>
            {
                downloadPct = p.Total > 0 ? Math.Round(100.0 * p.Done / p.Total, 0) : 0;
                downloadStatus = $"جارٍ التنزيل... {p.Done / 1024.0 / 1024.0:0.0} / {p.Total / 1024.0 / 1024.0:0.0} MB";
                StateHasChanged();
            });
            await updateService.DownloadAndInstallAsync(updateService.PendingUpdate, progress);
            downloadStatus = "تم التحضير. جارٍ الإغلاق والتثبيت...";
            StateHasChanged();
            await Task.Delay(1000);
            try { Application.Current?.Quit(); } catch { }
            Environment.Exit(0);
        }
        catch (Exception ex)
        {
            downloadInProgress = false;
            downloadStatus = "";
            toastService.ShowError("فشل التحديث: " + ex.Message, "❌ التحديثات");
        }
    }

