    private async Task TransferToMySql()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "سيتم استبدال كل البيانات في MySQL (الخادم) ببيانات SQLite المحلية. متابعة؟");
        if (!confirm) return;
        isTransferring = true;
        try
        {
            int count = await dataTransferService.TransferSqliteToMySqlAsync();
            toastService.ShowSuccess($"تم نقل {count} سجل من SQLite إلى MySQL", "✅ نقل إلى MySQL");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل النقل إلى MySQL: " + ex.Message, "❌ نقل إلى MySQL");
        }
        finally { isTransferring = false; }
    }

    private async Task TransferToSqlite()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "سيتم استبدال كل البيانات في SQLite المحلي ببيانات MySQL (الخادم). متابعة؟");
        if (!confirm) return;
        isTransferring = true;
        try
        {
            int count = await dataTransferService.TransferMySqlToSqliteAsync();
            toastService.ShowSuccess($"تم نقل {count} سجل من MySQL إلى SQLite", "✅ نقل إلى SQLite");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل النقل إلى SQLite: " + ex.Message, "❌ نقل إلى SQLite");
        }
        finally { isTransferring = false; }
    }

    private async Task ClearSupabase()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "سيتم مسح كل البيانات في Supabase نهائياً. متابعة؟");
        if (!confirm) return;
        isTransferring = true;
        try
        {
            await cloudSyncService.ClearSupabaseAsync();
            toastService.ShowSuccess("تم تفريغ كل جداول Supabase", "🗑️ تفريغ Supabase");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل تفريغ Supabase: " + ex.Message, "❌ تفريغ Supabase");
        }
        finally { isTransferring = false; }
    }

    private bool isSyncing = false;

    private async Task SyncNow()
    {
        isSyncing = true;
        try
        {
            await cloudSyncService.SyncAllAsync();
            toastService.ShowSuccess("تم رفع كل البيانات إلى Supabase بنجاح", "⬆️ مزامنة");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل الرفع: " + ex.Message, "❌ مزامنة");
        }
        finally { isSyncing = false; }
    }

    private async Task PullNow()
    {
        isSyncing = true;
        try
        {
            int count = await cloudSyncService.PullFromSupabaseAsync();
            toastService.ShowSuccess($"تم سحب {count} سجل من Supabase", "⬇️ سحب");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل السحب: " + ex.Message, "❌ سحب");
        }
        finally { isSyncing = false; }
    }

    private string templateDocType = "invoice";
    private PrintTemplateService.TemplateLayout currentLayout = new();
    private string previewHtml = "";

    private static readonly Dictionary<string, string> SectionTitles = new()
    {
        ["store"] = "🏪 شريط المتجر",
        ["title"] = "📌 عنوان الوثيقة",
        ["meta"] = "🧾 رقم / تاريخ / زبون",
        ["items"] = "📋 جدول الأصناف",
        ["totals"] = "💵 الإجماليات (المجموع / المدفوع / الدين)",
        ["signatures"] = "✍️ التواقيع (البائع / الزبون)",
        ["header"] = "🗣️ نص الرأس",
        ["footer"] = "🙏 نص التذييل",
        ["note"] = "📝 ملاحظة مخصصة"
    };

    private static string SectionTitle(string type) => SectionTitles.ContainsKey(type) ? SectionTitles[type] : type;

    private void SwitchTemplateType(string type)
    {
        templateDocType = type;
        currentLayout = printService.GetLayout(type);
        RefreshPreview();
    }

    private void RefreshPreview()
    {
        previewHtml = printService.RenderLayout(templateDocType, currentLayout, BuildSampleData());
    }

    private PrintTemplateService.PrintData BuildSampleData()
    {
        string title = templateDocType switch { "invoice" => "فاتورة", "delivery" => "بون تسليم", "receipt" => "وصل", _ => "وثيقة" };
        var data = new PrintTemplateService.PrintData
        {
            DocType = templateDocType,
            Title = title,
            InvoiceNumber = "000001",
            Date = DateTime.Now.ToString("yyyy-MM-dd HH:mm"),
            Customer = "زبون تجريبي",
            Cashier = "المدير",
            Items = new List<PrintTemplateService.PrintItem>
            {
                new("منتج تجريبي 1", 2, 1500, 3000),
                new("منتج تجريبي 2", 1, 750.50m, 750.50m)
            },
            Total = 3750.50m,
            Paid = 3000,
            Debt = 750.50m
        };
        // ملء بيانات المتجر والرأس/التذييل من الإعدادات لعرضها في المعاينة
        return printService.LoadStoreDefaults(data);
    }

    private void SaveLayoutNow()
    {
        printService.SaveLayout(templateDocType, currentLayout);
        RefreshPreview();
    }

    private void SaveTemplateNow()
    {
        try
        {
            printService.SaveLayout(templateDocType, currentLayout);
            toastService.ShowSuccess("تم حفظ قالب الطباعة بنجاح", "✅ حفظ القالب");
        }
        catch (Exception ex)
        {
