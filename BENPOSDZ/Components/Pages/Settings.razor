        try
        {
            discoveredServers = await dbService.DiscoverMySqlServersAsync();
            if (!discoveredServers.Any())
                toastService.ShowWarning("لم يتم العثور على أي خادم MySQL في الشبكة. تأكد من تشغيل الخادم واتصاله بنفس الشبكة.", "🔍 اكتشاف الخادم");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل الاكتشاف: " + ex.Message, "❌ اكتشاف الخادم");
        }
        finally
        {
            isDiscovering = false;
        }
    }

    private void SelectDiscoveredServer(string host)
    {
        settings[K_MySQL_Host] = host;
        toastService.ShowSuccess("تم اختيار الخادم: " + host + ". احفظ الإعدادات ثم جرّب الاتصال.", "🖥️ الخادم");
    }

    private async Task RunAudit()
    {
        isAuditing = true;
        try
        {
            auditResult = await dbService.AuditFinancialAccuracyAsync();
            showAuditModal = true;
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشل التدقيق: " + ex.Message, "❌ التدقيق");
        }
        finally
        {
            isAuditing = false;
        }
    }

    private void CloseAuditModal() => showAuditModal = false;

    private void RefreshLog() => StateHasChanged();

    private void ClearSystemLog()
    {
        dbService.ClearLog();
        toastService.ShowSuccess("تم مسح سجل النظام", "🗑️ السجل");
    }

    private async Task WipeFinancialData()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm",
            "تحذير! سيتم حذف كل الفواتير والمصاريف وتصفير الصندوق والديون نهائياً.\n" +
            "لا يمكن التراجع عن هذه العملية. هل أنت متأكد؟");
        if (!confirm) return;

        try
        {
            // نسخة احتياطية تلقائية قبل المحو (في الوضع المحلي)
            if (dbService.DBMode != "LAN")
            {
                string backup = dbService.BackupDatabase();
                lastBackupPath = backup;
            }

            int count = await dbService.WipeFinancialDataAsync(wipeResetStock);
            toastService.ShowSuccess($"تم محو كل العمليات المالية (أثر على {count} سجل)", "🧨 محو البيانات");
        }
        catch (Exception ex)
        {
            toastService.ShowError("فشلت العملية: " + ex.Message, "❌ محو البيانات");
        }
    }

