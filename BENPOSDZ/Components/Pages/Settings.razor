    }

    private async Task SaveActivationSecret()
    {
        if (string.IsNullOrWhiteSpace(activationSecret))
        {
            toastService.ShowWarning("الرجاء إدخال سر تفعيل جديد أو تركه فارغاً للعودة للافتراضي", "🔑 مفتاح التفعيل");
            return;
        }
        if (activationSecret.Length < 8)
        {
            toastService.ShowWarning("سر التفعيل يجب ألا يقل عن 8 أحرف", "🔑 مفتاح التفعيل");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", "سيتم تغيير سر التفعيل وسيصبح جميع أكواد التفعيل السابقة غير صالحة. هل أنت متأكد؟");
        if (!confirm) return;

        try
        {
            authService.SetActivationSecret(dbService, activationSecret);
            hasCustomActivationSecret = true;
            activationSecret = "";
            toastService.ShowSuccess("تم حفظ مفتاح التفعيل الجديد بنجاح", "🔑 مفتاح التفعيل");
        }
        catch (Exception ex)
        {
