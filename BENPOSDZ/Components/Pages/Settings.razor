    private async Task LoadTypeCountsAsync(IDbConnection connection, List<ProductTypeModel> types)
    {
        typeProductCounts = new Dictionary<string, int>();
        var counts = (await connection.QueryAsync<dynamic>(
            "SELECT Pro_Type_ID, COUNT(*) AS Cnt FROM Products WHERE IsDeleted = 0 AND Pro_Type_ID IS NOT NULL GROUP BY Pro_Type_ID")).ToList();
        foreach (var c in counts)
        {
            string? typeId = (string?)c.Pro_Type_ID;
            if (typeId != null) typeProductCounts[typeId] = (int)c.Cnt;
        }
    }

    private async Task AddType()
    {
        if (string.IsNullOrWhiteSpace(newTypeName)) return;
        
        using var connection = dbService.CreateConnection();
        using var transaction = connection.BeginTransaction(); // 🔥 الحماية الذرية
        try
        {
            var id = Guid.NewGuid().ToString("N"); // أكثر كفاءة للفهرسة
            await connection.ExecuteAsync(
                "INSERT INTO Product_Types (Id, Type_Name, UpdatedAt) VALUES (@Id, @Name, @Date)",
                new { Id = id, Name = newTypeName, Date = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") }, 
