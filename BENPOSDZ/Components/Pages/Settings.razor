@page "/settings"
@using BENPOSDZ.Services
@using Dapper
@using System.Data
@inject DatabaseService dbService
@inject IJSRuntime JS
@inject AuthService authService
@inject ISettingsRepository settingsRepository
@inject IApplicationStateService appState
@inject ToastService toastService
@inject NavigationManager Nav
@inject PrintTemplateService printService
@inject PrintService sysPrintService
@inject DataTransferService dataTransferService
@inject CloudSyncService cloudSyncService
@inject UpdateService updateService

<h2>الإعدادات العامة</h2>

<div class="tabs">
    <button class="tab-btn @(currentTab == "store" ? "active" : "")" @onclick='() => SwitchTab("store")'>🏪 المتجر</button>
    <button class="tab-btn @(currentTab == "types" ? "active" : "")" @onclick='() => SwitchTab("types")'>📦 الأنواع</button>
    <button class="tab-btn @(currentTab == "print" ? "active" : "")" @onclick='() => SwitchTab("print")'>🖨️ الطباعة</button>
    <button class="tab-btn @(currentTab == "conn" ? "active" : "")" @onclick='() => SwitchTab("conn")'>🌐 الاتصال</button>
    <button class="tab-btn @(currentTab == "backup" ? "active" : "")" @onclick='() => SwitchTab("backup")'>💾 النسخ الاحتياطي</button>
    <button class="tab-btn @(currentTab == "transfer" ? "active" : "")" @onclick='() => SwitchTab("transfer")'>🔄 نقل البيانات</button>
    <button class="tab-btn @(currentTab == "log" ? "active" : "")" @onclick='() => SwitchTab("log")'>📊 السجل</button>
    <button class="tab-btn @(currentTab == "lic" ? "active" : "")" @onclick='() => SwitchTab("lic")'>🔑 التفعيل</button>
    <button class="tab-btn @(currentTab == "update" ? "active" : "")" @onclick='() => SwitchTab("update")'>🔁 التحديثات</button>
</div>

@if (currentTab == "store")
{
    <div class="settings-card">
        <h3>معلومات المتجر</h3>
        <div class="form-group">
            <label>اسم المتجر (يظهر في الفواتير)</label>
            <input type="text" @bind="settings[K_StoreName]" disabled="@isStoreNameLocked" />
            @if (isStoreNameLocked) { <small style="color:red;">تم قفل الاسم بسبب التفعيل عبر الفلاشة</small> }
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>رقم الهاتف</label>
                <input type="text" @bind="settings[K_StorePhone]" />
            </div>
            <div class="form-group">
                <label>العنوان</label>
                <input type="text" @bind="settings[K_StoreAddress]" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>الرقم الجبائي (NIF)</label>
                <input type="text" @bind="settings[K_StoreNIF]" />
            </div>
            <div class="form-group">
                <label>السجل التجاري (RC)</label>
                <input type="text" @bind="settings[K_StoreRC]" />
            </div>
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" checked="@IsCaisseVisible" @onchange="ToggleCaisseVisibility" /> 
                السماح للبائع برؤية رصيد الصندوق (Caisse)
            </label>
        </div>
        <button class="btn-save" @onclick="SaveSettings">حفظ المعلومات</button>
    </div>
}
else if (currentTab == "types")
{
    <div class="settings-card" style="max-width: 900px;">
        <h3>أنواع المنتجات</h3>
        <div class="form-row" style="margin-bottom: 20px;">
            <input type="text" @bind="newTypeName" placeholder="اسم النوع الجديد (مثال: مشروبات)" />
            <button class="btn-save" style="width: 200px;" @onclick="AddType">إضافة</button>
        </div>
        <table class="mini-table">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>النوع</th>
                    <th style="width: 90px;">المنتجات</th>
                    <th style="width: 60px;">حذف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in productTypes)
                {
                    <tr>
                        <td><button class="type-expand-btn" @onclick="() => ToggleType(t.Id)" title="عرض منتجات هذا النوع">@(expandedTypeId == t.Id ? "▼" : "▶")</button></td>
                        <td>@t.Type_Name</td>
                        <td class="type-count-badge">@GetTypeProductCount(t.Id)</td>
                        <td><button class="btn-delete" @onclick="() => DeleteType(t.Id)">🗑️</button></td>
                    </tr>
                    @if (expandedTypeId == t.Id)
                    {
                        <tr>
                            <td colspan="4" style="padding: 0; border-bottom: none;">
                                <div class="type-products-box">
                                    @if (typeProductsLoading)
                                    {
                                        <p class="hint">جارٍ تحميل المنتجات...</p>
                                    }
                                    else if (typeProducts.Count == 0)
                                    {
                                        <p class="hint">لا توجد منتجات في هذا النوع.</p>
                                    }
                                    else
                                    {
                                        <table class="mini-table">
                                            <thead>
                                                <tr>
                                                    <th>الاسم</th>
                                                    <th>العلامة</th>
                                                    <th>الكمية</th>
                                                    <th>سعر الجملة</th>
                                                    <th>سعر التجزئة</th>
                                                    <th>الإجراءات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in typeProducts)
                                                {
                                                    <tr>
                                                        <td>@p.Pro_Name</td>
                                                        <td>@p.Pro_Mark</td>
                                                        <td class="@(p.Pro_Qty <= p.Pro_QtyMin && p.Pro_QtyMin > 0 ? "low-stock" : "")">@p.Pro_Qty @p.Pro_Unit</td>
                                                        <td>@p.Pro_SalePriceG د.ج</td>
                                                        <td>@p.Pro_SalePrice_Max د.ج</td>
                                                        <td style="white-space: nowrap;">
                                                            <button class="btn-edit" @onclick="() => EditTypeProduct(p)">تعديل</button>
                                                            <button class="btn-delete" @onclick="() => DeleteTypeProduct(p.Id)">حذف</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (showTypeProductModal)
    {
        <div class="modal-overlay">
            <div class="modal-box editor">
                <h3>تعديل منتج</h3>
                <div class="form-group">
                    <label>اسم السلعة *</label>
                    <input type="text" @bind="typeProductEdit.Pro_Name" placeholder="مثال: قهوة" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>العلامة التجارية</label>
                        <input type="text" @bind="typeProductEdit.Pro_Mark" placeholder="مثال: Nescafé" />
                    </div>
                    <div class="form-group">
                        <label>الخصائص</label>
                        <input type="text" @bind="typeProductEdit.Pro_Propr" placeholder="مثال: 100غ" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>نوع المنتج</label>
                        <select @bind="typeProductEdit.Pro_Type_ID">
                            <option value="">-- اختر النوع --</option>
                            @foreach (var type in productTypes)
                            {
                                <option value="@type.Id">@type.Type_Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>وحدة القياس</label>
                        <input type="text" @bind="typeProductEdit.Pro_Unit" placeholder="مثال: علبة، كيلو" />
                    </div>
                    <div class="form-group">
                        <label>الباركود</label>
                        <input type="text" @bind="typeProductEdit.Pro_Barcode" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>الكمية الحالية</label>
                        <input type="number" @bind="typeProductEdit.Pro_Qty" />
                    </div>
                    <div class="form-group">
                        <label>حد التنبيه (الحد الأدنى)</label>
                        <input type="number" @bind="typeProductEdit.Pro_QtyMin" />
                    </div>
                </div>
                <div class="form-row">
                    @if (authService.IsAdmin)
                    {
                        <div class="form-group">
                            <label>سعر الشراء (دج)</label>
                            <input type="number" @bind="typeProductEdit.Pro_BuyPrice" />
                        </div>
                    }
                    <div class="form-group">
                        <label>سعر الجملة (دج)</label>
                        <input type="number" @bind="typeProductEdit.Pro_SalePriceG" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>سعر التجزئة الأدنى (دج)</label>
                        <input type="number" @bind="typeProductEdit.Pro_SalePrice_Min" />
                    </div>
                    <div class="form-group">
                        <label>سعر التجزئة الأعلى (دج)</label>
                        <input type="number" @bind="typeProductEdit.Pro_SalePrice_Max" />
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="btn-save" @onclick="SaveTypeProduct">حفظ التعديل</button>
                    <button class="btn-cancel-sm" @onclick="CloseTypeProductModal">إلغاء</button>
                </div>
            </div>
        </div>
    }
}
else if (currentTab == "print")
{
    <style>
        .visual-sections { display: flex; flex-direction: column; gap: 8px; margin: 15px 0; }
        .sec-row { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 8px 12px; flex-wrap: wrap; }
        .sec-row.disabled { opacity: 0.55; }
        .sec-toggle { display: flex; align-items: center; gap: 8px; font-size: 15px; cursor: pointer; flex: 1; min-width: 220px; }
        .sec-toggle input { width: 18px; height: 18px; }
        .sec-actions { display: flex; gap: 5px; }
        .sec-actions button { background: #e9ecef; border: 1px solid #ccc; border-radius: 6px; cursor: pointer; padding: 4px 8px; font-size: 14px; }
        .sec-actions button:hover { background: #dee2e6; }
        .sec-note-text { flex: 1 1 100%; border: 1px solid #ddd; border-radius: 6px; padding: 6px 8px; font-size: 14px; }
        .btn-add-note { margin-top: 8px; background: #17a2b8; color: #fff; border: none; border-radius: 6px; padding: 8px 14px; cursor: pointer; }
        .print-live-preview { border: 1px solid #ddd; border-radius: 8px; background: #fff; width: 100%; height: 480px; }
    </style>

    <div class="settings-card print-editor-card">
        <h3>قوالب الطباعة الاحترافية</h3>
        <p class="print-hint">اختر نوع الوثيقة، ثم أظهر/أخفِ الأقسام وأعد ترتيبها بالأزرار — القالب يُحفظ تلقائياً وتظهر المعاينة مباشرة.</p>

        <div class="form-group" style="margin-bottom:15px;">
            <label>
                <input type="checkbox" checked="@IsSellNoPrint" @onchange="ToggleSellNoPrint" />
                🛑 البيع بدون طباعة — لا يُطلب طباعة الوصل بعد إتمام البيع، وتظهر رسالة "شكراً على الشراء" تلقائياً وتختفي بسرعة
            </label>
        </div>

        <div class="print-types">
            <button type="button" class="print-type-btn @(templateDocType == "invoice" ? "active" : "")" @onclick='() => SwitchTemplateType("invoice")'>📄 فاتورة (A4)</button>
            <button type="button" class="print-type-btn @(templateDocType == "delivery" ? "active" : "")" @onclick='() => SwitchTemplateType("delivery")'>🚚 بون تسليم (BL)</button>
            <button type="button" class="print-type-btn @(templateDocType == "receipt" ? "active" : "")" @onclick='() => SwitchTemplateType("receipt")'>🧾 وصل (80mm)</button>
        </div>

        <div class="visual-sections">
            @for (int i = 0; i < currentLayout.Sections.Count; i++)
            {
                var s = currentLayout.Sections[i];
                int idx = i;
                <div class="sec-row @(s.Enabled ? "" : "disabled")">
                    <label class="sec-toggle">
                        <input type="checkbox" @bind="s.Enabled" @bind:after="SaveLayoutNow" />
                        <span>@SectionTitle(s.Type)</span>
                    </label>
                    <div class="sec-actions">
                        <button @onclick="() => MoveSection(idx, -1)" title="تحريك لأعلى">⬆</button>
                        <button @onclick="() => MoveSection(idx, 1)" title="تحريك لأسفل">⬇</button>
                        <button @onclick="() => DeleteSection(s)" title="حذف هذا القسم">🗑️</button>
                    </div>
                    @if (s.Type == "note" || s.Type == "header" || s.Type == "footer" || s.Type == "title")
                    {
                        <input class="sec-note-text" @bind="s.Text" @bind:event="oninput" @bind:after="SaveLayoutNow" placeholder="@SectionTextPlaceholder(s.Type)" />
                    }
                </div>
            }
        </div>
        <button class="btn-add-note" @onclick="AddNote">➕ إضافة ملاحظة مخصصة</button>

        <div class="form-group" style="margin-top:15px;">
            <label>المعاينة الحية (ببيانات تجريبية):</label>
            <iframe class="print-live-preview" srcdoc="@previewHtml"></iframe>
        </div>

        <div class="form-group" style="margin-top:15px;">
            <label>نص الرأس (يظهر عبر قسم "نص الرأس")</label>
            <textarea @bind="settings[K_ReceiptHeader]" rows="2" placeholder="مرحباً بكم في متجرنا"></textarea>
        </div>
        <div class="form-group">
            <label>نص التذييل (يظهر عبر قسم "نص التذييل")</label>
            <textarea @bind="settings[K_ReceiptFooter]" rows="2" placeholder="شكراً لزيارتكم — لا ترد بعد هذا اليوم"></textarea>
        </div>

        <div class="print-actions">
            <button class="btn-save" @onclick="SaveTemplateNow">💾 حفظ القالب</button>
            <button class="btn-save" style="background:#6c757d;" @onclick="ResetTemplateNow">♻️ استعادة الافتراضي</button>
            <button class="btn-save" style="background:#28a745;" @onclick="PrintTest">🖨️ طباعة تجريبية</button>
            <button class="btn-save" style="background:#6f42c1;" @onclick="ShareTest">📤 مشاركة المعاينة</button>
            <button class="btn-save" style="background:#fd7e14;" @onclick="ExportWord">📄 تصدير Word</button>
            <button class="btn-save" style="background:#17a2b8;" @onclick="SaveSettings">حفظ الرأس/التذييل</button>
        </div>
    </div>
}
else if (currentTab == "conn")
{
    <div class="settings-card">
        <h3>إعدادات الاتصال وقاعدة البيانات</h3>
        <div class="form-group">
            <label>وضع قاعدة البيانات</label>
            <select @bind="settings[K_DBMode]" class="form-control">
                <option value="Local">محلي (SQLite) - جهاز واحد</option>
                <option value="LAN">شبكة محلية (MySQL) - عدة أجهزة</option>
            </select>
        </div>
        @if (settings.ContainsKey(K_DBMode) && settings[K_DBMode] == "LAN")
        {
            <div class="form-group">
                <label>عنوان خادم MySQL (Host أو IP)</label>
                <div class="host-row">
                    <input type="text" @bind="settings[K_MySQL_Host]" placeholder="مثال: server-pos أو 192.168.1.10" />
                    <button type="button" class="btn-save" style="background:#17a2b8; margin-top:0; white-space:nowrap;" @onclick="DiscoverServers" disabled="@isDiscovering">🔍 اكتشاف الخادم</button>
                </div>
                @if (isDiscovering) { <small style="color:#007bff;">جاري فحص الشبكة المحلية... قد يستغرق ثواني</small> }
                @if (discoveredServers.Any())
                {
                    <div class="discovered-box">
                        <small style="color:#666;">الخوادم المكتشفة (اضغط على أي خادم لاختياره):</small>
                        @foreach (var s in discoveredServers)
                        {
                            <button type="button" class="discovered-item" @onclick="() => SelectDiscoveredServer(s)">🖥️ @s</button>
                        }
                    </div>
                }
            </div>
            <div class="form-row">
                <div class="form-group"><label>اسم المستخدم</label><input type="text" @bind="settings[K_MySQL_User]" /></div>
                <div class="form-group"><label>كلمة المرور</label><input type="password" @bind="settings[K_MySQL_Pass]" /></div>
            </div>
        }
        <hr />
        <div class="form-group">
            <label>تفعيل المزامنة السحابية (Supabase)</label>
            <select @bind="settings[K_CloudSyncEnabled]" class="form-control">
                <option value="false">معطلة</option>
                <option value="true">مفعلة</option>
            </select>
        </div>
        <div class="form-group">
            <label>Supabase URL</label>
            <input type="text" @bind="settings[K_SupabaseURL]" />
        </div>
        <div class="form-group">
            <label>Supabase Key (تُعرض مخفية لأمان أكبر)</label>
            <input type="password" @bind="settings[K_SupabaseKey]" autocomplete="new-password" />
            <small style="color:#666;">المفتاح محفوظ في قاعدة البيانات المحلية ولا يظهر إلا عند إعادة كتابته.</small>
        </div>

        <div class="form-group">
            <label>حالة الاتصال الحالية:</label>
            <input type="text" value="@appState.ConnectionStatus" readonly class="form-control" style="font-weight: bold; background: #f8f9fa;" />
        </div>

        <div class="form-group">
            <label>أدوات المزامنة السحابية:</label>
            <div class="backup-row">
                <button class="btn-save" style="background:#17a2b8;" @onclick="SyncNow" disabled="@isSyncing">
                    ⬆️ @(isSyncing ? "جاري الرفع..." : "رفع كل البيانات إلى Supabase")
                </button>
                <button class="btn-save" style="background:#28a745;" @onclick="PullNow" disabled="@isSyncing">
                    ⬇️ @(isSyncing ? "جاري السحب..." : "سحب كل البيانات من Supabase")
                </button>
            </div>
            <small style="color:#666;">السحب يدمج سجلات Supabase في القاعدة المحلية (آخر تعديل يفوز) ويستخدم للاستعادة من نسخة سحابية.</small>
        </div>

        <button class="btn-save" @onclick="SaveSettings">حفظ إعدادات الاتصال</button>
    </div>
}
else if (currentTab == "backup")
{
    <div class="settings-card">
        <h3>النسخ الاحتياطي والصيانة</h3>
        <div class="form-group">
            <label>النسخ الاحتياطي والاستعادة:</label>
            <div class="backup-row">
                <button class="btn-save" style="background: #17a2b8;" @onclick="BackupNow">💾 إنشاء نسخة احتياطية</button>
                <button class="btn-save" style="background: #fd7e14;" @onclick="RestoreNow">♻️ استعادة أحدث نسخة</button>
            </div>
            @if (!string.IsNullOrEmpty(lastBackupPath))
            {
                <small style="color:#666; word-break:break-all;">آخر نسخة: @lastBackupPath</small>
            }
        </div>
        <hr />
        <div class="form-group">
            <label>صيانة قاعدة البيانات:</label>
            <button class="btn-save" style="background: #ffc107; color: black;" @onclick="CleanData">
                🧹 تنظيف البيانات من الفواصل العشرية الخاطئة
            </button>
        </div>
        <hr />
        <div class="form-group">
            <label>فحص دقة الحسابات المالية:</label>
            <p style="color:#666; font-size:13px;">
                يتحقق من مطابقة تفاصيل الفواتير مع الإجماليات، وصحة المدفوعات والديون، ويحسب إجمالي المبيعات والمشتريات.
            </p>
            <button class="btn-save" style="background: #6f42c1;" @onclick="RunAudit" disabled="@isAuditing">
                🧾 @(isAuditing ? "جاري التدقيق..." : "فحص دقة الحسابات المالية")
            </button>
        </div>
        <hr />
        <div class="form-group danger-zone">
            <label style="color:#dc3545; font-size:18px;">🧨 منطقة الخطر — محو العمليات المالية</label>
            <p style="color:#dc3545; font-size:13px; margin:5px 0;">
                سيتم حذف <strong>جميع الفواتير والمرتجعات والمصاريف</strong> وتصفير <strong>الصندوق</strong> و<strong>ديون الزبائن</strong>.
                ستبقى المنتجات والأشخاص والمستخدمون والإعدادات كما هي.
            </p>
            <label style="display:flex; align-items:center; gap:8px; font-size:14px; cursor:pointer;">
                <input type="checkbox" @bind="wipeResetStock" style="width:auto;" />
                إعادة تعيين أرصدة المخزون (Pro_Qty) إلى صفر أيضاً
            </label>
            <button class="btn-save btn-wipe" @onclick="WipeFinancialData" style="background:#dc3545; margin-top:10px;">
                🧨 محو كل العمليات المالية نهائياً
            </button>
        </div>
    </div>
}
else if (currentTab == "transfer")
{
    <div class="settings-card">
        <h3>🔄 نقل البيانات بين القواعد</h3>
        <p style="color:#666; font-size:13px;">
            انقل كل البيانات التجارية (المنتجات، الأشخاص، الفواتير، المصاريف، الأنواع، الصندوق) من SQLite المحلي إلى MySQL أو العكس.
            التحويل يستبدل بيانات الوجهة بالكامل. تأكد من أن الخادم قيد التشغيل قبل النقل.
        </p>

        <div class="form-group">
            <label>من SQLite (محلي) إلى MySQL (الخادم):</label>
            <button class="btn-save" style="background:#28a745;" @onclick="TransferToMySql" disabled="@isTransferring">
                ➡️ @(isTransferring ? "جاري النقل..." : "نقل كل البيانات إلى MySQL")
            </button>
        </div>
        <hr />
        <div class="form-group">
            <label>من MySQL (الخادم) إلى SQLite (محلي):</label>
            <button class="btn-save" style="background:#17a2b8;" @onclick="TransferToSqlite" disabled="@isTransferring">
                ⬅️ @(isTransferring ? "جاري النقل..." : "نقل كل البيانات إلى SQLite")
            </button>
        </div>
        <hr />
        <div class="form-group danger-zone">
            <label style="color:#dc3545; font-size:16px;">🗑️ تفريغ Supabase</label>
            <p style="color:#dc3545; font-size:13px; margin:5px 0;">
                مسح <strong>كل الجداول البعيدة في Supabase</strong> (المنتجات، الأشخاص، الفواتير، المصاريف) لتجنب أي خلط في البيانات،
                دون التأثير على القاعدة المحلية. ستُعاد المزامنة من الصفر بعدها.
            </p>
            <button class="btn-save" style="background:#dc3545;" @onclick="ClearSupabase" disabled="@isTransferring">
                🗑️ @(isTransferring ? "جاري التفريغ..." : "تفريغ كل جداول Supabase")
            </button>
        </div>
    </div>
}
else if (currentTab == "log")
{
    <div class="settings-card">
        <h3>سجل النظام (System Log)</h3>
        <p style="color:#666; font-size:13px;">سجل العمليات والأخطاء الخلفية — يُحفظ في ملف System.log داخل مجلد البرنامج.</p>
        <p style="font-size:13px;">
            ⚡ أداء الاستعلامات: <strong>@QueryProfiler.SlowQueryCount</strong> استعلام بطيء (+400ms) في هذه الجلسة —
            الاستعلامات البطيئة تُسجل أدناه برسالة ⚠️ (تُستخدم لفحص أداء وضع LAN على MySQL).
        </p>
        <div class="log-actions">
            <button class="btn-save" style="background:#17a2b8; margin-top:0;" @onclick="RefreshLog">🔄 تحديث</button>
            <button class="btn-save" style="background:#6c757d; margin-top:0;" @onclick="dbService.OpenLogFolder">📂 فتح مجلد السجلات</button>
            <button class="btn-save" style="background:#dc3545; margin-top:0;" @onclick="ClearSystemLog">🗑️ مسح السجل</button>
        </div>
        <div class="form-group">
            <label>سجل العمليات الخلفية:</label>
            <textarea rows="18" readonly class="form-control" style="font-family: monospace; font-size: 12px; background: #1e293b; color: #94a3b8;">@dbService.SystemLog</textarea>
        </div>
    </div>
}
else if (currentTab == "lic")
{
    <div class="settings-card" style="text-align: center;">
        <h3>التفعيل وإدارة الترخيص</h3>
        @if (isLicensed)
        {
            <p style="color: green; font-size: 20px; font-weight: bold;">✅ البرنامج مُفعل</p>
            <p>تاريخ انتهاء الترخيص الحالي: <strong>@settings[K_LicenseExpiryDate]</strong></p>
        }
        else
        {
            <p style="color: red; font-size: 20px; font-weight: bold;">⏳ انتهت النسخة التجريبية</p>
        }

        <hr />
        <h4>طريقة 1: تفعيل بكود سري (سنة واحدة)</h4>
        <div class="machine-id-box">
            <label>رقم الجهاز (Machine ID):</label>
            <h2 style="color: #007bff; letter-spacing: 2px;">@machineId</h2>
        </div>
        <div class="form-group">
            <input type="text" @bind="enteredLicenseKey" placeholder="000000" maxlength="6" style="text-align: center; font-size: 24px; letter-spacing: 5px;" />
        </div>
        <button class="btn-save" @onclick="ActivateWithCode">تفعيل بالكود</button>

        <hr style="margin: 30px 0;" />
        <h4>طريقة 2: تفعيل بفلاشة المفاتيح (3 سنوات / 5 أجهزة)</h4>
        <p style="font-size: 12px; color: #666;">أدخل اسم المتجر بدقة كما تم تسجيله في المفتاح، ثم وصل الفلاشة واضغط تفعيل. (سيتم قفل اسم المتجر).</p>
        <div class="form-group">
            <input type="text" @bind="usbStoreName" placeholder="اسم المتجر المسجل في المفتاح" />
        </div>
        <button class="btn-save" style="background: #28a745;" @onclick="ActivateWithUsb">🔓 تفعيل بالفلاشة</button>

        <hr style="margin: 30px 0;" />
        <h4>🔑 مفتاح التفعيل (سر التفعيل)</h4>
        <p style="font-size: 12px; color: #666;">
            يستخدم لتوليد أكواد التفعيل. عند تغييره تصبح الأكواد القديمة غير صالحة، لذا غيّره فقط عند الرغبة في إلغاء تفعيلات سابقة.
        </p>
        <div class="form-group">
            <input type="text" @bind="activationSecret" placeholder="أدخل سر التفعيل الجديد (يُستخدم الافتراضي إن تُرك فارغاً)" />
            <small style="color: #666;">الحالي: @(hasCustomActivationSecret ? "مخصص (محفوظ محلياً)" : "افتراضي")</small>
        </div>
        <button class="btn-save" style="background: #6f42c1;" @onclick="SaveActivationSecret">💾 حفظ مفتاح التفعيل</button>

        <hr style="margin: 30px 0;" />
        <h4>تحديث البرنامج</h4>
        <button class="btn-save" style="background: #17a2b8;" @onclick='() => SwitchTab("update")'>🔄 الانتقال لإعدادات التحديثات</button>
    </div>
}
else if (currentTab == "update")
{
    <div class="settings-card" style="max-width: 700px;">
        <h3>🔁 التحديثات</h3>
        <p class="print-hint">الإصدار الحالي: <strong>@currentAppVersion</strong></p>

        <div class="form-group">
            <label>رابط مستودع GitHub للتحديثات</label>
            <input type="text" @bind="updateRepoUrl" placeholder="https://github.com/owner/repo" />
            <small style="color:#666;">يُرفع عليه ملفا <code>version.json</code> وحزمة التحديث في كل Release جديد.</small>
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" @bind="updateCheckOnStart" /> الفحص التلقائي عند إقلاع البرنامج
            </label>
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" @bind="updateCheckPeriodic" /> فحص دوري كل 24 ساعة أثناء التشغيل
            </label>
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" @bind="updateAutoDownload" /> تنزيل التحديث تلقائياً عند توفره
            </label>
        </div>
        <button class="btn-save" @onclick="SaveUpdateSettings">💾 حفظ إعدادات التحديث</button>
        <button class="btn-save" style="background:#17a2b8;" @onclick="CheckForUpdates" disabled="@updateService.IsBusy">
            @(updateService.IsBusy ? "جارٍ الفحص..." : "🔄 التحقق من التحديثات الآن")
        </button>

        @if (updateService.PendingUpdate != null)
        {
            <div class="update-info-box">
                <strong>✅ تحديث متوفر: v@(updateService.PendingUpdate.version)</strong>
                <div class="update-notes">@updateService.PendingUpdate.notes</div>
                <button class="btn-save" style="background:#28a745;" @onclick="StartUpdateDownload" disabled="@updateService.IsBusy">📥 تنزيل وتحديث الآن</button>
            </div>
        }
        else if (updateLastCheck != null)
        {
            <div class="update-info-box" style="border-color:#ccc; background:#f9f9f9;">
                <strong>✅ أنت تستخدم أحدث إصدار</strong>
                <small class="print-hint">آخر فحص: @updateLastCheck</small>
            </div>
        }

        @if (downloadInProgress)
        {
            <div style="margin-top:15px;">
                <div class="progress"><div class="progress-bar" style="width:@(downloadPct)%;"></div></div>
                <p class="print-hint">@downloadStatus</p>
            </div>
        }
    </div>
}

@if (showAuditModal && auditResult != null)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h3>نتيجة فحص دقة الحسابات المالية</h3>
            <p>
                عدد الفواتير المفحوصة: <strong>@auditResult.InvoicesChecked</strong> |
                إجمالي المبيعات: <strong>@auditResult.SalesTotal.ToString("0.00") د.ج</strong> |
                إجمالي المشتريات: <strong>@auditResult.PurchaseTotal.ToString("0.00") د.ج</strong>
            </p>
            <div class="audit-results">
                @foreach (var issue in auditResult.Issues)
                {
                    <div class="audit-line @(issue.StartsWith("✅") ? "ok" : "err")">@issue</div>
                }
            </div>
            <button class="btn-cancel" @onclick="CloseAuditModal" style="width:100%">إغلاق</button>
        </div>
    </div>
}

