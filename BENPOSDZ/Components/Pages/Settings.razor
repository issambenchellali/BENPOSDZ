    private async Task ActivateWithUsb()
    {
        if (string.IsNullOrWhiteSpace(usbStoreName)) { toastService.ShowError("الرجاء إدخال اسم المتجر", "❌ تفعيل بالفلاشة"); return; }
        string result = authService.TryActivateUsb(dbService, usbStoreName);
        if (result.StartsWith("SUCCESS"))
        {
            settings[K_LicenseExpiryDate] = result.Split('|')[1];
            isStoreNameLocked = true;
            settings[K_StoreName] = usbStoreName;
            await SaveSettings();
            isLicensed = true;
            toastService.ShowSuccess("تمت إضافة 3 سنوات وقفل اسم المتجر", "✅ تفعيل بالفلاشة");
        }
        else { toastService.ShowError(result, "❌ تفعيل بالفلاشة"); }
    }
	
