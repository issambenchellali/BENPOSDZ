    private void CheckLicenseStatus()
    {
        if (!string.IsNullOrEmpty(settings[K_LicenseExpiryDate]))
        {
            if (DateTime.TryParse(settings[K_LicenseExpiryDate], out var expDate) && expDate > DateTime.UtcNow)
            {
                isLicensed = true;
                return;
            }
        }
        isLicensed = false;
        if (string.IsNullOrEmpty(settings[K_TrialStartDate])) settings[K_TrialStartDate] = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss");
        var trialStart = DateTime.Parse(settings[K_TrialStartDate]);
        daysLeft = 15 - (int)(DateTime.UtcNow - trialStart).TotalDays;
        if (daysLeft < 0) daysLeft = 0;
    }

